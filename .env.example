# ==============================================================
# KONFIGURASI SUPABASE (CLOUD POSTGRESQL & STORAGE)
# ==============================================================
# Salin URI koneksi PostgreSQL dari Supabase (Project Settings > Database > Connection String > URI / Transaction Pooler)
# Contoh: postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Kredensial Supabase Storage (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kunci Enkripsi Sesi Cookie (Opsional)
SESSION_SECRET=kyzoo-lms-super-secret-key-2026

# ==============================================================
# KONFIGURASI SMTP GMAIL KYZOO LMS
# ==============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Kyzoo LMS" <your_email@gmail.com>

# Port Lokal
PORT=3000
