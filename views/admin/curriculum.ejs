<!-- Admin: Kelola Materi Berbasis Linear Episode (Tanpa Bab & Tanpa Turunan) -->

<div class="space-y-6">

  <!-- Header Info Kursus & Tombol Tambah Episode -->
  <div class="bg-white rounded-[22px] border border-slate-100 p-6 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <a href="/admin" class="text-xs font-bold text-brand-600 hover:underline">← Panel Admin</a>
        <span class="text-slate-300">/</span>
        <span class="text-xs font-bold text-slate-500 font-mono"><%= course.code %></span>
      </div>
      <div class="flex items-center gap-3 mt-1.5 flex-wrap">
        <h2 class="text-xl font-black text-slate-900 tracking-tight">Kelola Materi: <%= course.title %></h2>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-50 text-brand-600 border border-brand-200/60">
          <%= lessons.length %> Episode Terdaftar
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-1">Susun materi secara linear per episode. Siswa dapat membaca teori, menonton video, serta mengunduh gambar/slide presentasi PPT.</p>
    </div>

    <!-- Tombol Tambah Episode Baru -->
    <button onclick="openAddLessonModal()" class="px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white rounded-xl font-bold text-xs flex items-center gap-2 shadow-md shadow-dynamic-glow transition-all self-start sm:self-auto">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
      <span>Tambah Episode Baru</span>
    </button>
  </div>

  <!-- Notifikasi Pesan -->
  <% if (success) { %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold rounded-2xl flex items-center gap-2 shadow-xs">
      <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      <span><%= success %></span>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold rounded-2xl flex items-center gap-2 shadow-xs">
      <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Daftar Episode Pembelajaran (Tabel / Card Linear) -->
  <div class="bg-white rounded-[22px] border border-slate-100 p-6 shadow-sm space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <div>
        <h3 class="text-base font-bold text-slate-900">Urutan Episode Materi</h3>
        <p class="text-xs text-slate-400 mt-0.5">Episode ditampilkan sesuai urutan pembelajaran yang dilihat oleh pelanggan.</p>
      </div>
      <a href="/courses/<%= course.slug %>" target="_blank" class="text-xs font-semibold text-brand-600 hover:underline flex items-center gap-1">
        <span>Lihat Tampilan Siswa</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
      </a>
    </div>

    <% if (lessons.length === 0) { %>
      <div class="py-16 text-center space-y-3">
        <div class="w-16 h-16 rounded-3xl bg-slate-100 flex items-center justify-center text-slate-400 mx-auto text-2xl">
          📚
        </div>
        <p class="text-sm font-semibold text-slate-600">Belum ada episode materi yang dibuat untuk kursus ini.</p>
        <p class="text-xs text-slate-400 max-w-sm mx-auto">Klik tombol di bawah untuk menambahkan materi pertama berupa teks panduan, video tutorial, atau file PPT/gambar.</p>
        <button onclick="openAddLessonModal()" class="mt-2 px-5 py-2.5 bg-brand-500 text-white font-bold text-xs rounded-xl shadow-md shadow-dynamic-glow">
          + Buat Episode Pertama
        </button>
      </div>
    <% } else { %>
      <div class="divide-y divide-slate-100">
        <% lessons.forEach((l, idx) => { %>
          <div class="py-4 flex flex-col md:flex-row md:items-center justify-between gap-4 hover:bg-slate-50/60 p-3 rounded-2xl transition-all">
            
            <!-- Info Episode -->
            <div class="flex items-start sm:items-center gap-3.5 min-w-0">
              <span class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 font-extrabold text-xs flex items-center justify-center shrink-0 border border-brand-100">
                EP <%= String(idx + 1).padStart(2, '0') %>
              </span>

              <div class="min-w-0 space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <h4 class="text-sm font-bold text-slate-900 truncate"><%= l.title %></h4>
                  
                  <% if (l.video_url) { %>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-violet-50 text-violet-700 border border-violet-100 flex items-center gap-1">
                      <span>🎥 Video Tutorial</span>
                      <span class="uppercase text-[9px] opacity-75">(<%= l.video_source %>)</span>
                    </span>
                  <% } else { %>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-slate-100 text-slate-600">
                      📄 Teks Panduan Saja
                    </span>
                  <% } %>

                  <!-- Badge Lampiran Berkas Gambar / Slide PPT / Dokumen -->
                  <% if (l.attachment_url) { %>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200/80 flex items-center gap-1">
                      <% if (l.attachment_type === 'image') { %>
                        <span>🖼️ Gambar / Diagram</span>
                      <% } else if (l.attachment_type === 'ppt') { %>
                        <span>📊 Slide PPT</span>
                      <% } else if (l.attachment_type === 'pdf') { %>
                        <span>📑 Dokumen PDF</span>
                      <% } else { %>
                        <span>📎 Lampiran Berkas</span>
                      <% } %>
                    </span>
                  <% } %>

                  <span class="text-[11px] font-medium text-slate-400">⏱️ <%= l.duration_minutes %> Menit</span>
                </div>

                <% if (l.content_text) { %>
                  <p class="text-xs text-slate-500 line-clamp-1 max-w-xl">
                    <%= l.content_text.substring(0, 120) %>...
                  </p>
                <% } else { %>
                  <p class="text-xs text-slate-400 italic">Tidak ada catatan teks teori.</p>
                <% } %>
              </div>
            </div>

            <!-- Tombol Aksi -->
            <div class="flex items-center gap-2 self-end md:self-auto shrink-0">
              <!-- Preview Halaman Belajar -->
              <a href="/learn/<%= course.slug %>/<%= l.id %>" target="_blank" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1" title="Lihat di Peramban">
                <span>Buka</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </a>

              <!-- Edit Episode (Menggunakan ID lookup aman) -->
              <button type="button" onclick="openEditLessonModal('<%= l.id %>')" class="px-3 py-1.5 bg-brand-50 hover:bg-brand-500 hover:text-white text-brand-700 rounded-lg text-xs font-bold transition-all flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                <span>Edit</span>
              </button>

              <!-- Hapus Episode -->
              <form action="/admin/lessons/<%= l.id %>/delete" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus Episode ini?');" class="inline">
                <button type="submit" class="p-1.5 text-rose-500 hover:bg-rose-50 rounded-lg transition-colors" title="Hapus Episode">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
              </form>
            </div>

          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

</div>

<!-- ========================================== -->
<!-- MODAL TAMBAH EPISODE BARU                  -->
<!-- ========================================== -->
<div id="modalAddLesson" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-3xl p-6 sm:p-7 max-w-lg w-full shadow-2xl max-h-[92vh] overflow-y-auto space-y-5">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <div>
        <h3 class="text-base font-bold text-slate-900">Tambah Episode Baru</h3>
        <p class="text-xs text-slate-400 mt-0.5">Isi materi teori dan sertakan video atau berkas pendukung (opsional).</p>
      </div>
      <button type="button" onclick="closeModal('modalAddLesson')" class="w-8 h-8 rounded-full hover:bg-slate-100 text-slate-400 flex items-center justify-center">✕</button>
    </div>

    <form action="/admin/courses/<%= course.id %>/episodes/new" method="POST" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Judul Episode *</label>
        <input type="text" name="title" required placeholder="Contoh: Cara Download & Install Antigravity IDE" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm text-slate-800 font-medium">
      </div>

      <!-- Teks Panduan & Rangkuman Materi Teori dengan Toolbar Format Teks Cepat -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-bold text-slate-700">Teks Panduan / Teori Pembelajaran</label>
          <span class="text-[10px] text-slate-400 font-medium">Klik tombol untuk format cepat</span>
        </div>

        <!-- Toolbar Format Cepat (Bold, Italic, Judul, List, Quote, Code, Link) -->
        <div class="flex items-center gap-1 p-1.5 bg-slate-100 border border-slate-200 rounded-t-xl overflow-x-auto no-scrollbar">
          <button type="button" onclick="formatLessonText('add', 'bold')" class="px-2.5 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-black shadow-2xs transition-colors" title="Tebal (**teks**)">
            B
          </button>
          <button type="button" onclick="formatLessonText('add', 'italic')" class="px-2.5 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs italic font-serif shadow-2xs transition-colors" title="Miring (*teks*)">
            I
          </button>
          <div class="h-4 w-px bg-slate-300 mx-0.5"></div>
          <button type="button" onclick="formatLessonText('add', 'h2')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-bold shadow-2xs transition-colors" title="Subjudul (## Judul)">
            H2
          </button>
          <button type="button" onclick="formatLessonText('add', 'h3')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-semibold shadow-2xs transition-colors" title="Poin Topik (### Poin)">
            H3
          </button>
          <div class="h-4 w-px bg-slate-300 mx-0.5"></div>
          <button type="button" onclick="formatLessonText('add', 'bullet')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-medium shadow-2xs transition-colors flex items-center gap-1" title="Daftar Poin (- Poin)">
            <span>•</span>
            <span>List</span>
          </button>
          <button type="button" onclick="formatLessonText('add', 'number')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-medium shadow-2xs transition-colors flex items-center gap-1" title="Daftar Nomor (1. Langkah)">
            <span>1.</span>
            <span>Nomor</span>
          </button>
          <div class="h-4 w-px bg-slate-300 mx-0.5"></div>
          <button type="button" onclick="formatLessonText('add', 'quote')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-medium shadow-2xs transition-colors flex items-center gap-1" title="Kotak Catatan / Tips (> Catatan)">
            <span>💡</span>
            <span>Tips</span>
          </button>
          <button type="button" onclick="formatLessonText('add', 'code')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-mono shadow-2xs transition-colors" title="Kode / Istilah (`kode`)">
            &lt;/&gt;
          </button>
          <button type="button" onclick="formatLessonText('add', 'link')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-medium shadow-2xs transition-colors flex items-center gap-1" title="Tautan Link ([Teks](url))">
            <span>🔗</span>
            <span>Link</span>
          </button>
        </div>

        <textarea id="addContentText" name="content_text" rows="5" placeholder="Tuliskan rangkuman konsep, penjelasan teori, atau poin-poin langkah... (Blok kalimat lalu klik tombol B di atas untuk membuat teks tebal!)" class="w-full px-4 py-2.5 bg-slate-50 border border-t-0 border-slate-200 rounded-b-xl text-xs sm:text-sm text-slate-800 leading-relaxed focus:outline-none focus:border-brand-500"></textarea>
      </div>

      <!-- 1. Seksi Opsi Video Tutorial (Opsional) -->
      <div class="p-4 bg-slate-50/80 border border-slate-200 rounded-2xl space-y-3">
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="addHasVideoCheck" name="has_video" value="yes" checked onchange="toggleAddVideoFields(this.checked)" class="w-4 h-4 text-brand-600 rounded">
            <span class="text-xs font-bold text-slate-800">Sertakan Video Tutorial (Opsional)</span>
          </label>
          <span class="text-[10px] text-slate-400 font-semibold bg-white px-2 py-0.5 rounded border border-slate-200">Bisa dikosongkan</span>
        </div>

        <div id="addVideoFieldsBox" class="space-y-3 pt-2 border-t border-slate-200">
          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Sumber Video</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <label class="flex items-center gap-2 p-2 bg-white border border-slate-200 rounded-xl cursor-pointer">
                <input type="radio" name="video_source" value="youtube" checked onchange="toggleVideoInputType('add', 'link')">
                <span class="font-semibold text-[11px]">Link YouTube / Drive</span>
              </label>
              <label class="flex items-center gap-2 p-2 bg-white border border-slate-200 rounded-xl cursor-pointer">
                <input type="radio" name="video_source" value="upload" onchange="toggleVideoInputType('add', 'upload')">
                <span class="font-semibold text-[11px]">Upload File MP4</span>
              </label>
            </div>
          </div>

          <div id="boxAddVideoLink">
            <label class="block text-[11px] font-bold text-slate-600 mb-1">URL Video</label>
            <input type="url" id="addVideoUrl" name="video_url" placeholder="https://www.youtube.com/watch?v=..." class="w-full px-3.5 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-800">
          </div>

          <div id="boxAddVideoFile" class="hidden">
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Pilih File Video MP4</label>
            <input type="file" id="addVideoFile" name="video_file" accept="video/mp4,video/webm" class="text-xs text-slate-500 file:mr-2 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-violet-100 file:text-violet-700">
          </div>
        </div>
      </div>

      <!-- 2. Seksi Opsi Berkas Gambar / Slide PPT / Dokumen (Opsional) -->
      <div class="p-4 bg-slate-50/80 border border-slate-200 rounded-2xl space-y-3">
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="addHasAttachmentCheck" name="has_attachment" value="yes" onchange="toggleAddAttachmentFields(this.checked)" class="w-4 h-4 text-brand-600 rounded">
            <span class="text-xs font-bold text-slate-800">Sertakan File Gambar / PPT / Dokumen (Opsional)</span>
          </label>
          <span class="text-[10px] text-slate-400 font-semibold bg-white px-2 py-0.5 rounded border border-slate-200">Bisa dikosongkan</span>
        </div>

        <div id="addAttachmentFieldsBox" class="space-y-3 pt-2 border-t border-slate-200 hidden">
          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Metode Lampiran</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <label class="flex items-center gap-2 p-2 bg-white border border-slate-200 rounded-xl cursor-pointer">
                <input type="radio" name="attachment_source" value="upload" checked onchange="toggleAttachmentInputType('add', 'upload')">
                <span class="font-semibold text-[11px]">Upload Berkas File</span>
              </label>
              <label class="flex items-center gap-2 p-2 bg-white border border-slate-200 rounded-xl cursor-pointer">
                <input type="radio" name="attachment_source" value="link" onchange="toggleAttachmentInputType('add', 'link')">
                <span class="font-semibold text-[11px]">Tautan Google Slides / Canva</span>
              </label>
            </div>
          </div>

          <div id="boxAddAttachmentFile">
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Pilih File (Gambar PNG/JPG, Dokumen PDF, PPT/PPTX)</label>
            <input type="file" id="addAttachmentFile" name="attachment_file" accept="image/*,.pdf,.ppt,.pptx,.doc,.docx,.zip" class="text-xs text-slate-500 file:mr-2 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-amber-100 file:text-amber-800">
          </div>

          <div id="boxAddAttachmentLink" class="hidden">
            <label class="block text-[11px] font-bold text-slate-600 mb-1">URL / Tautan Presentasi</label>
            <input type="url" id="addAttachmentUrl" name="attachment_url" placeholder="https://docs.google.com/presentation/... atau link file" class="w-full px-3.5 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-800">
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Judul Tampilan Berkas (Opsional)</label>
            <input type="text" id="addAttachmentName" name="attachment_name" placeholder="Contoh: Slide Modul 1 atau Diagram Arsitektur" class="w-full px-3.5 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-800">
          </div>
        </div>
      </div>

      <!-- Estimasi Durasi Belajar -->
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Estimasi Durasi Belajar (Menit) *</label>
        <div class="relative flex items-center">
          <input type="number" id="addDurationInput" name="duration_minutes" value="10" min="1" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm text-slate-800 font-bold pr-14">
          <span class="absolute right-3 text-xs font-bold text-slate-400 pointer-events-none">Menit</span>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
        <button type="button" onclick="closeModal('modalAddLesson')" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100">Batal</button>
        <button type="submit" class="px-6 py-2.5 bg-brand-500 hover:bg-brand-600 text-white rounded-xl text-xs font-bold shadow-md shadow-dynamic-glow">Simpan Episode</button>
      </div>
    </form>
  </div>
</div>

<!-- ========================================== -->
<!-- MODAL EDIT EPISODE                         -->
<!-- ========================================== -->
<div id="modalEditLesson" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-3xl p-6 sm:p-7 max-w-lg w-full shadow-2xl max-h-[92vh] overflow-y-auto space-y-5">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <div>
        <h3 class="text-base font-bold text-slate-900">Edit Data Episode</h3>
        <p class="text-xs text-slate-400 mt-0.5">Perbarui isi materi teori, video, atau berkas lampiran.</p>
      </div>
      <button type="button" onclick="closeModal('modalEditLesson')" class="w-8 h-8 rounded-full hover:bg-slate-100 text-slate-400 flex items-center justify-center">✕</button>
    </div>

    <form id="formEditLesson" action="" method="POST" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Judul Episode *</label>
        <input type="text" id="editTitle" name="title" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm text-slate-800 font-medium">
      </div>

      <!-- Teks Panduan & Rangkuman Materi Teori dengan Toolbar Format Teks Cepat -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-bold text-slate-700">Teks Panduan / Teori Pembelajaran</label>
          <span class="text-[10px] text-slate-400 font-medium">Klik tombol untuk format cepat</span>
        </div>

        <!-- Toolbar Format Cepat (Bold, Italic, Judul, List, Quote, Code, Link) -->
        <div class="flex items-center gap-1 p-1.5 bg-slate-100 border border-slate-200 rounded-t-xl overflow-x-auto no-scrollbar">
          <button type="button" onclick="formatLessonText('edit', 'bold')" class="px-2.5 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-black shadow-2xs transition-colors" title="Tebal (**teks**)">
            B
          </button>
          <button type="button" onclick="formatLessonText('edit', 'italic')" class="px-2.5 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs italic font-serif shadow-2xs transition-colors" title="Miring (*teks*)">
            I
          </button>
          <div class="h-4 w-px bg-slate-300 mx-0.5"></div>
          <button type="button" onclick="formatLessonText('edit', 'h2')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-bold shadow-2xs transition-colors" title="Subjudul (## Judul)">
            H2
          </button>
          <button type="button" onclick="formatLessonText('edit', 'h3')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-semibold shadow-2xs transition-colors" title="Poin Topik (### Poin)">
            H3
          </button>
          <div class="h-4 w-px bg-slate-300 mx-0.5"></div>
          <button type="button" onclick="formatLessonText('edit', 'bullet')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-medium shadow-2xs transition-colors flex items-center gap-1" title="Daftar Poin (- Poin)">
            <span>•</span>
            <span>List</span>
          </button>
          <button type="button" onclick="formatLessonText('edit', 'number')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-medium shadow-2xs transition-colors flex items-center gap-1" title="Daftar Nomor (1. Langkah)">
            <span>1.</span>
            <span>Nomor</span>
          </button>
          <div class="h-4 w-px bg-slate-300 mx-0.5"></div>
          <button type="button" onclick="formatLessonText('edit', 'quote')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-medium shadow-2xs transition-colors flex items-center gap-1" title="Kotak Catatan / Tips (> Catatan)">
            <span>💡</span>
            <span>Tips</span>
          </button>
          <button type="button" onclick="formatLessonText('edit', 'code')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-mono shadow-2xs transition-colors" title="Kode / Istilah (`kode`)">
            &lt;/&gt;
          </button>
          <button type="button" onclick="formatLessonText('edit', 'link')" class="px-2 py-1 bg-white hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-medium shadow-2xs transition-colors flex items-center gap-1" title="Tautan Link ([Teks](url))">
            <span>🔗</span>
            <span>Link</span>
          </button>
        </div>

        <textarea id="editContentText" name="content_text" rows="5" class="w-full px-4 py-2.5 bg-slate-50 border border-t-0 border-slate-200 rounded-b-xl text-xs sm:text-sm text-slate-800 leading-relaxed focus:outline-none focus:border-brand-500"></textarea>
      </div>

      <!-- 1. Seksi Opsi Video (Opsional) -->
      <div class="p-4 bg-slate-50/80 border border-slate-200 rounded-2xl space-y-3">
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="editHasVideoCheck" name="has_video" value="yes" onchange="toggleEditVideoFields(this.checked)" class="w-4 h-4 text-brand-600 rounded">
            <span class="text-xs font-bold text-slate-800">Sertakan Video Tutorial (Opsional)</span>
          </label>
        </div>

        <div id="editVideoFieldsBox" class="space-y-3 pt-2 border-t border-slate-200">
          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Sumber Video</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <label class="flex items-center gap-2 p-2 bg-white border border-slate-200 rounded-xl cursor-pointer">
                <input type="radio" id="editRadioLink" name="video_source" value="youtube" onchange="toggleVideoInputType('edit', 'link')">
                <span class="font-semibold text-[11px]">Link YouTube / Drive</span>
              </label>
              <label class="flex items-center gap-2 p-2 bg-white border border-slate-200 rounded-xl cursor-pointer">
                <input type="radio" id="editRadioUpload" name="video_source" value="upload" onchange="toggleVideoInputType('edit', 'upload')">
                <span class="font-semibold text-[11px]">Upload File MP4</span>
              </label>
            </div>
          </div>

          <div id="boxEditVideoLink">
            <label class="block text-[11px] font-bold text-slate-600 mb-1">URL Video</label>
            <input type="text" id="editVideoUrl" name="video_url" placeholder="https://www.youtube.com/watch?v=..." class="w-full px-3.5 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-800">
          </div>

          <div id="boxEditVideoFile" class="hidden">
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Ganti File Video MP4 (Opsional)</label>
            <input type="file" id="editVideoFile" name="video_file" accept="video/mp4,video/webm" class="text-xs text-slate-500 file:mr-2 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-violet-100 file:text-violet-700">
          </div>
        </div>
      </div>

      <!-- 2. Seksi Opsi Berkas Gambar / Slide PPT / Dokumen (Opsional) -->
      <div class="p-4 bg-slate-50/80 border border-slate-200 rounded-2xl space-y-3">
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="editHasAttachmentCheck" name="has_attachment" value="yes" onchange="toggleEditAttachmentFields(this.checked)" class="w-4 h-4 text-brand-600 rounded">
            <span class="text-xs font-bold text-slate-800">Sertakan File Gambar / PPT / Dokumen (Opsional)</span>
          </label>
        </div>

        <div id="editAttachmentFieldsBox" class="space-y-3 pt-2 border-t border-slate-200 hidden">
          <!-- Info Berkas Saat Ini -->
          <div id="boxCurrentAttachmentInfo" class="hidden p-2.5 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 flex items-center justify-between">
            <div class="flex items-center gap-2 truncate">
              <span>📎</span>
              <span id="currentAttachmentLabel" class="font-bold truncate">Berkas saat ini</span>
            </div>
            <a id="currentAttachmentLink" href="#" target="_blank" class="text-[11px] font-bold text-amber-700 underline shrink-0">Lihat Berkas ↗</a>
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Metode Lampiran</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <label class="flex items-center gap-2 p-2 bg-white border border-slate-200 rounded-xl cursor-pointer">
                <input type="radio" id="editAttachmentRadioUpload" name="attachment_source" value="upload" checked onchange="toggleAttachmentInputType('edit', 'upload')">
                <span class="font-semibold text-[11px]">Upload Berkas Baru</span>
              </label>
              <label class="flex items-center gap-2 p-2 bg-white border border-slate-200 rounded-xl cursor-pointer">
                <input type="radio" id="editAttachmentRadioLink" name="attachment_source" value="link" onchange="toggleAttachmentInputType('edit', 'link')">
                <span class="font-semibold text-[11px]">Tautan Google Slides / Canva</span>
              </label>
            </div>
          </div>

          <div id="boxEditAttachmentFile">
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Ganti Berkas (Gambar PNG/JPG, Dokumen PDF, PPT/PPTX)</label>
            <input type="file" id="editAttachmentFile" name="attachment_file" accept="image/*,.pdf,.ppt,.pptx,.doc,.docx,.zip" class="text-xs text-slate-500 file:mr-2 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-amber-100 file:text-amber-800">
          </div>

          <div id="boxEditAttachmentLink" class="hidden">
            <label class="block text-[11px] font-bold text-slate-600 mb-1">URL / Tautan Presentasi</label>
            <input type="url" id="editAttachmentUrl" name="attachment_url" placeholder="https://docs.google.com/presentation/... atau link file" class="w-full px-3.5 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-800">
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Judul Tampilan Berkas (Opsional)</label>
            <input type="text" id="editAttachmentName" name="attachment_name" placeholder="Contoh: Slide Modul 1 atau Diagram Arsitektur" class="w-full px-3.5 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-800">
          </div>
        </div>
      </div>

      <!-- Estimasi Durasi Belajar -->
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Estimasi Durasi Belajar (Menit) *</label>
        <div class="relative flex items-center">
          <input type="number" id="editDurationInput" name="duration_minutes" value="10" min="1" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm text-slate-800 font-bold pr-14">
          <span class="absolute right-3 text-xs font-bold text-slate-400 pointer-events-none">Menit</span>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
        <button type="button" onclick="closeModal('modalEditLesson')" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100">Batal</button>
        <button type="submit" class="px-6 py-2.5 bg-brand-500 hover:bg-brand-600 text-white rounded-xl text-xs font-bold shadow-md shadow-dynamic-glow">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<!-- Data JSON Lessons Client (Aman dari kutip & linter) -->
<script type="application/json" id="curriculumLessonsJson">
<%- JSON.stringify(lessons || []) %>
</script>

<script>
  const curriculumLessons = JSON.parse(document.getElementById('curriculumLessonsJson').textContent || '[]');

  function openAddLessonModal() {
    document.getElementById('modalAddLesson').classList.remove('hidden');
  }

  function openEditLessonModal(id) {
    const lesson = curriculumLessons.find(l => String(l.id) === String(id));
    if (!lesson) {
      alert('Data episode tidak ditemukan.');
      return;
    }

    const form = document.getElementById('formEditLesson');
    form.action = `/admin/lessons/${lesson.id}/edit`;

    document.getElementById('editTitle').value = lesson.title || '';
    document.getElementById('editContentText').value = lesson.content_text || '';
    document.getElementById('editDurationInput').value = lesson.duration_minutes || 10;

    // 1. Setup Status Video
    const hasVideo = !!(lesson.video_url && lesson.video_url.trim());
    const hasVideoCheck = document.getElementById('editHasVideoCheck');
    hasVideoCheck.checked = hasVideo;
    toggleEditVideoFields(hasVideo);

    if (lesson.video_source === 'upload') {
      document.getElementById('editRadioUpload').checked = true;
      toggleVideoInputType('edit', 'upload');
    } else {
      document.getElementById('editRadioLink').checked = true;
      toggleVideoInputType('edit', 'link');
    }
    document.getElementById('editVideoUrl').value = lesson.video_url || '';

    // 2. Setup Status Lampiran Berkas / Gambar / PPT
    const hasAttachment = !!(lesson.attachment_url && lesson.attachment_url.trim());
    const hasAttachmentCheck = document.getElementById('editHasAttachmentCheck');
    hasAttachmentCheck.checked = hasAttachment;
    toggleEditAttachmentFields(hasAttachment);

    document.getElementById('editAttachmentName').value = lesson.attachment_name || '';
    document.getElementById('editAttachmentUrl').value = lesson.attachment_url || '';

    const currentInfoBox = document.getElementById('boxCurrentAttachmentInfo');
    const currentLabel = document.getElementById('currentAttachmentLabel');
    const currentLink = document.getElementById('currentAttachmentLink');

    if (hasAttachment) {
      currentInfoBox.classList.remove('hidden');
      currentLabel.textContent = lesson.attachment_name || 'Berkas Terlampir';
      currentLink.href = lesson.attachment_url;
    } else {
      currentInfoBox.classList.add('hidden');
    }

    document.getElementById('modalEditLesson').classList.remove('hidden');
  }

  function closeModal(modalId) {
    document.getElementById(modalId).classList.add('hidden');
  }

  // Toggle Video
  function toggleAddVideoFields(show) {
    const box = document.getElementById('addVideoFieldsBox');
    if (show) box.classList.remove('hidden');
    else box.classList.add('hidden');
  }

  function toggleEditVideoFields(show) {
    const box = document.getElementById('editVideoFieldsBox');
    if (show) box.classList.remove('hidden');
    else box.classList.add('hidden');
  }

  function toggleVideoInputType(prefix, mode) {
    const boxLink = document.getElementById(prefix === 'add' ? 'boxAddVideoLink' : 'boxEditVideoLink');
    const boxFile = document.getElementById(prefix === 'add' ? 'boxAddVideoFile' : 'boxEditVideoFile');

    if (mode === 'upload') {
      boxLink.classList.add('hidden');
      boxFile.classList.remove('hidden');
    } else {
      boxLink.classList.remove('hidden');
      boxFile.classList.add('hidden');
    }
  }

  // Toggle Attachment (Gambar / PPT / PDF)
  function toggleAddAttachmentFields(show) {
    const box = document.getElementById('addAttachmentFieldsBox');
    if (show) box.classList.remove('hidden');
    else box.classList.add('hidden');
  }

  function toggleEditAttachmentFields(show) {
    const box = document.getElementById('editAttachmentFieldsBox');
    if (show) box.classList.remove('hidden');
    else box.classList.add('hidden');
  }

  function toggleAttachmentInputType(prefix, mode) {
    const boxFile = document.getElementById(prefix === 'add' ? 'boxAddAttachmentFile' : 'boxEditAttachmentFile');
    const boxLink = document.getElementById(prefix === 'add' ? 'boxAddAttachmentLink' : 'boxEditAttachmentLink');

    if (mode === 'upload') {
      boxFile.classList.remove('hidden');
      boxLink.classList.add('hidden');
    } else {
      boxFile.classList.add('hidden');
      boxLink.classList.remove('hidden');
    }
  }

  // Format Teks Cepat (Bold, Italic, Judul, List, dll)
  function formatLessonText(prefix, action) {
    const textarea = document.getElementById(prefix === 'add' ? 'addContentText' : 'editContentText');
    if (!textarea) return;

    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const text = textarea.value;
    const selected = text.substring(start, end);

    let replacement = '';
    let cursorOffset = 0;

    switch (action) {
      case 'bold':
        replacement = selected ? `**${selected}**` : '**teks tebal**';
        cursorOffset = selected ? replacement.length : 2;
        break;
      case 'italic':
        replacement = selected ? `*${selected}*` : '*teks miring*';
        cursorOffset = selected ? replacement.length : 1;
        break;
      case 'h2':
        replacement = selected ? `\n\n## ${selected}\n` : '\n\n## Judul Subtopik\n';
        cursorOffset = replacement.length;
        break;
      case 'h3':
        replacement = selected ? `\n\n### ${selected}\n` : '\n\n### Poin Pembahasan\n';
        cursorOffset = replacement.length;
        break;
      case 'bullet':
        if (selected) {
          replacement = selected.split('\n').map(l => l.startsWith('- ') ? l : `- ${l}`).join('\n');
        } else {
          replacement = '\n- Poin materi pertama\n- Poin materi kedua\n';
        }
        cursorOffset = replacement.length;
        break;
      case 'number':
        if (selected) {
          replacement = selected.split('\n').map((l, i) => `${i + 1}. ${l}`).join('\n');
        } else {
          replacement = '\n1. Langkah pertama\n2. Langkah kedua\n';
        }
        cursorOffset = replacement.length;
        break;
      case 'quote':
        replacement = selected ? `\n> ${selected}\n` : '\n> Catatan: Poin penting yang wajib diingat...\n';
        cursorOffset = replacement.length;
        break;
      case 'code':
        replacement = selected ? `\`${selected}\`` : '`kode_atau_istilah`';
        cursorOffset = selected ? replacement.length : 1;
        break;
      case 'link':
        const url = prompt('Masukkan URL tautan:', 'https://');
        if (url) {
          replacement = selected ? `[${selected}](${url})` : `[Buka Tautan](${url})`;
          cursorOffset = replacement.length;
        } else {
          return;
        }
        break;
    }

    textarea.value = text.substring(0, start) + replacement + text.substring(end);
    textarea.focus();
    const newPos = start + cursorOffset;
    textarea.setSelectionRange(newPos, newPos);
  }
</script>
