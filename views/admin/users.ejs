<!-- Admin: Kelola Anggota & Pengguna LMS (CRUD) -->

<div class="space-y-6">

  <!-- Alert Notifikasi Sukses / Error -->
  <% if (success) { %>
    <div class="p-4 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 text-xs sm:text-sm rounded-2xl flex items-center justify-between gap-3 shadow-xs animate-in fade-in">
      <div class="flex items-center gap-2.5">
        <svg class="w-5 h-5 shrink-0 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span class="font-bold"><%= success %></span>
      </div>
      <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 p-1">✕</button>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="p-4 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300 text-xs sm:text-sm rounded-2xl flex items-center justify-between gap-3 shadow-xs animate-in fade-in">
      <div class="flex items-center gap-2.5">
        <svg class="w-5 h-5 shrink-0 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span class="font-bold"><%= error %></span>
      </div>
      <button onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 p-1">✕</button>
    </div>
  <% } %>

  <!-- Header & Tombol Tambah Anggota -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-slate-900 rounded-[24px] border border-slate-200/80 dark:border-slate-800 p-6 sm:p-7 shadow-xs">
    <div>
      <div class="flex items-center gap-2.5 mb-1.5">
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-400 border border-amber-200/80 dark:border-amber-900/50">
          Mode Admin
        </span>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          Kelola Anggota & Pengguna
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-medium">
        Tambah akun pengguna baru, atur hak akses (Pelanggan / Admin), perbarui kata sandi, atau hapus anggota.
      </p>
    </div>

    <button 
      type="button" 
      onclick="openAddUserModal()" 
      class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-brand-500 hover:bg-brand-600 text-white rounded-xl font-bold text-xs sm:text-sm shadow-md shadow-dynamic-glow transition-all hover:scale-[1.02] active:scale-[0.98] shrink-0"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
      </svg>
      <span>+ Tambah Anggota Baru</span>
    </button>
  </div>

  <!-- 3 Ringkasan Metrik Anggota -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <!-- Card 1: Total Anggota -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-xs flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-brand-50 dark:bg-brand-950/40 border border-brand-100 dark:border-brand-900/50 flex items-center justify-center text-brand-500 shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
      </div>
      <div>
        <div class="text-xs font-semibold text-slate-400">Total Akun Terdaftar</div>
        <div class="text-2xl font-black text-slate-900 dark:text-white leading-tight mt-0.5"><%= stats.totalUsers %></div>
        <div class="text-[11px] text-slate-400">Semua pengguna di sistem</div>
      </div>
    </div>

    <!-- Card 2: Pelanggan Aktif -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-xs flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-100 dark:border-emerald-900/50 flex items-center justify-center text-emerald-600 shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
      </div>
      <div>
        <div class="text-xs font-semibold text-slate-400">Pelanggan (Siswa)</div>
        <div class="text-2xl font-black text-slate-900 dark:text-white leading-tight mt-0.5"><%= stats.totalPelanggan %></div>
        <div class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold">Hak akses menonton & belajar</div>
      </div>
    </div>

    <!-- Card 3: Administrator -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-xs flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-100 dark:border-amber-900/50 flex items-center justify-center text-amber-600 shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
      </div>
      <div>
        <div class="text-xs font-semibold text-slate-400">Administrator</div>
        <div class="text-2xl font-black text-slate-900 dark:text-white leading-tight mt-0.5"><%= stats.totalAdmins %></div>
        <div class="text-[11px] text-amber-600 dark:text-amber-400 font-semibold">Pengelola materi & sistem</div>
      </div>
    </div>
  </div>

  <!-- Tabel Anggota + Pencarian & Filter -->
  <div class="bg-white dark:bg-slate-900 rounded-[24px] border border-slate-200/80 dark:border-slate-800 p-6 sm:p-7 shadow-xs">
    
    <!-- Filter Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
      <!-- Search Form -->
      <form action="/admin/users" method="GET" class="relative flex-1 max-w-md">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <input 
          type="text" 
          name="q" 
          placeholder="Cari nama atau email anggota..." 
          value="<%= q %>"
          class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 rounded-xl text-xs sm:text-sm text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all"
        />
        <% if (filterRole && filterRole !== 'all') { %>
          <input type="hidden" name="role" value="<%= filterRole %>">
        <% } %>
      </form>

      <!-- Role Filter Tabs -->
      <div class="inline-flex p-1 bg-slate-100 dark:bg-slate-800 rounded-xl border border-slate-200/60 dark:border-slate-700 text-xs font-bold shrink-0">
        <a href="/admin/users?q=<%= encodeURIComponent(q) %>&role=all" class="px-3 py-1.5 rounded-lg transition-all <%= (filterRole === 'all') ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs' : 'text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white' %>">
          Semua (<%= stats.totalUsers %>)
        </a>
        <a href="/admin/users?q=<%= encodeURIComponent(q) %>&role=pelanggan" class="px-3 py-1.5 rounded-lg transition-all <%= (filterRole === 'pelanggan') ? 'bg-white dark:bg-slate-700 text-emerald-600 dark:text-emerald-400 shadow-xs' : 'text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white' %>">
          Pelanggan (<%= stats.totalPelanggan %>)
        </a>
        <a href="/admin/users?q=<%= encodeURIComponent(q) %>&role=admin" class="px-3 py-1.5 rounded-lg transition-all <%= (filterRole === 'admin') ? 'bg-white dark:bg-slate-700 text-amber-600 dark:text-amber-400 shadow-xs' : 'text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white' %>">
          Admin (<%= stats.totalAdmins %>)
        </a>
      </div>
    </div>

    <!-- Tabel Data Anggota -->
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 dark:border-slate-800 pb-3">
            <th class="py-3 px-3 w-12 text-center">#</th>
            <th class="py-3 px-4">Nama Anggota</th>
            <th class="py-3 px-4">Email Akun</th>
            <th class="py-3 px-4 text-center">Peran (Role)</th>
            <th class="py-3 px-4 text-center">Materi Selesai</th>
            <th class="py-3 px-4">Terdaftar</th>
            <th class="py-3 px-4 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100/80 dark:divide-slate-800 text-xs sm:text-sm">
          <% if (users.length === 0) { %>
            <tr>
              <td colspan="7" class="py-12 text-center text-slate-400 italic">
                Tidak ada data anggota yang cocok dengan pencarian Anda.
              </td>
            </tr>
          <% } else { %>
            <% users.forEach((u, idx) => { %>
              <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/50 transition-colors group">
                <!-- No -->
                <td class="py-3.5 px-3 text-center font-bold text-slate-400">
                  <%= idx + 1 %>
                </td>

                <!-- Nama & Avatar -->
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-3">
                    <img 
                      src="<%= u.avatar || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80' %>" 
                      alt="<%= u.name %>" 
                      class="w-9 h-9 rounded-full object-cover ring-2 ring-slate-100 dark:ring-slate-700 shrink-0 shadow-2xs"
                    />
                    <div class="min-w-0">
                      <div class="font-extrabold text-slate-800 dark:text-slate-100 flex items-center gap-1.5">
                        <span><%= u.name %></span>
                        <% if (currentUser && currentUser.id === u.id) { %>
                          <span class="px-1.5 py-0.5 rounded text-[9px] font-black bg-brand-100 text-brand-700 dark:bg-brand-950 dark:text-brand-300">
                            (Anda)
                          </span>
                        <% } %>
                      </div>
                      <div class="text-[11px] text-slate-400 font-mono">ID: #<%= u.id %></div>
                    </div>
                  </div>
                </td>

                <!-- Email -->
                <td class="py-3.5 px-4 font-medium text-slate-600 dark:text-slate-300">
                  <%= u.email %>
                </td>

                <!-- Role Badge -->
                <td class="py-3.5 px-4 text-center">
                  <% if (u.role === 'admin') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 border border-amber-200/80 dark:border-amber-900/50">
                      <span>👑</span>
                      <span>Admin</span>
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-900/50">
                      <span>🎓</span>
                      <span>Pelanggan</span>
                    </span>
                  <% } %>
                </td>

                <!-- Video Selesai -->
                <td class="py-3.5 px-4 text-center font-bold text-slate-700 dark:text-slate-300">
                  <span class="px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-[11px]">
                    🎬 <%= u.completed_lessons %> Selesai
                  </span>
                </td>

                <!-- Terdaftar Sejak -->
                <td class="py-3.5 px-4 text-slate-400 text-xs">
                  <%= u.created_at ? new Date(u.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-' %>
                </td>

                <!-- Tombol Aksi -->
                <td class="py-3.5 px-4 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <!-- Tombol Edit -->
                    <button 
                      type="button"
                      onclick="openEditUserModal('<%= u.id %>', '<%= encodeURIComponent(u.name) %>', '<%= u.email %>', '<%= u.role %>', '<%= encodeURIComponent(u.avatar || '') %>')"
                      class="p-2 rounded-xl text-slate-500 hover:text-brand-600 hover:bg-brand-50 dark:hover:bg-slate-800 transition-colors"
                      title="Edit Data Anggota"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    </button>

                    <!-- Tombol Hapus (Disable jika akun sendiri) -->
                    <% if (currentUser && currentUser.id === u.id) { %>
                      <button 
                        type="button" 
                        disabled 
                        class="p-2 rounded-xl text-slate-300 dark:text-slate-700 cursor-not-allowed opacity-50"
                        title="Tidak dapat menghapus akun Anda sendiri"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                      </button>
                    <% } else { %>
                      <button 
                        type="button" 
                        onclick="openDeleteUserModal('<%= u.id %>', '<%= encodeURIComponent(u.name) %>', '<%= u.email %>')"
                        class="p-2 rounded-xl text-slate-500 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-colors"
                        title="Hapus Anggota"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                      </button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>

</div>

<!-- ============================================================== -->
<!-- MODAL 1: TAMBAH ANGGOTA BARU -->
<!-- ============================================================== -->
<div id="addUserModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-in fade-in">
  <div class="bg-white dark:bg-slate-900 rounded-[28px] border border-slate-200/90 dark:border-slate-800 shadow-2xl w-full max-w-lg p-6 sm:p-7 space-y-5 text-slate-800 dark:text-slate-100">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-brand-50 dark:bg-brand-950/50 text-brand-500 flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
        </div>
        <h3 class="text-lg font-black tracking-tight">Tambah Anggota Baru</h3>
      </div>
      <button type="button" onclick="closeAddUserModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1.5 rounded-lg">✕</button>
    </div>

    <form action="/admin/users" method="POST" enctype="multipart/form-data" class="space-y-4">
      <!-- Foto Profil / Avatar (Opsional) -->
      <div>
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Foto Profil / Avatar <span class="text-slate-400 font-normal">(Opsional)</span></label>
        <div class="flex items-center gap-3 p-3 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-200 dark:border-slate-700">
          <img id="addUserAvatarPreview" src="https://api.dicebear.com/7.x/bottts/svg?seed=new" alt="Preview" class="w-12 h-12 rounded-xl object-cover ring-2 ring-brand-500/30 border border-slate-200 dark:border-slate-700 shrink-0">
          <div class="flex-1 min-w-0">
            <input 
              type="file" 
              name="avatar_file" 
              id="addUserAvatarInput"
              accept="image/jpeg,image/png,image/webp,image/gif"
              onchange="previewAddUserAvatar(this)"
              class="w-full text-xs text-slate-500 dark:text-slate-400 file:mr-2.5 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-brand-50 dark:file:bg-brand-950/50 file:text-brand-600 dark:file:text-brand-400 hover:file:bg-brand-100 cursor-pointer"
            />
            <p class="text-[10px] text-slate-400 mt-1">Format: JPG, PNG, WEBP, GIF (Maks. 8MB). Jika kosong, avatar default akan dibuat otomatis.</p>
          </div>
        </div>
      </div>

      <!-- Nama Lengkap -->
      <div>
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Nama Lengkap <span class="text-rose-500">*</span></label>
        <input 
          type="text" 
          name="name" 
          required 
          placeholder="Contoh: Rian Pratama"
          class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs sm:text-sm text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500"
        />
      </div>

      <!-- Alamat Email -->
      <div>
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Alamat Email <span class="text-rose-500">*</span></label>
        <input 
          type="email" 
          name="email" 
          required 
          placeholder="rian@example.com"
          class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs sm:text-sm text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500"
        />
      </div>

      <!-- Password Awal -->
      <div>
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Password Masuk <span class="text-rose-500">*</span></label>
        <div class="relative">
          <input 
            type="password" 
            name="password" 
            id="addPasswordInput"
            required 
            placeholder="Minimal 6 karakter"
            class="w-full pl-4 pr-11 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs sm:text-sm text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500"
          />
          <button 
            type="button" 
            onclick="togglePasswordVisibility('addPasswordInput', this)" 
            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600"
          >
            👁️
          </button>
        </div>
      </div>

      <!-- Peran / Role -->
      <div>
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Peran Akun (Hak Akses) <span class="text-rose-500">*</span></label>
        <div class="grid grid-cols-2 gap-3">
          <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer">
            <input type="radio" name="role" value="pelanggan" checked class="text-brand-500 focus:ring-brand-500" />
            <div>
              <div class="text-xs font-bold text-slate-800 dark:text-slate-200">Pelanggan</div>
              <div class="text-[10px] text-slate-400">Hanya tonton & belajar</div>
            </div>
          </label>
          <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer">
            <input type="radio" name="role" value="admin" class="text-brand-500 focus:ring-brand-500" />
            <div>
              <div class="text-xs font-bold text-slate-800 dark:text-slate-200">Administrator</div>
              <div class="text-[10px] text-slate-400">Akses penuh CRUD</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Tombol Aksi -->
