<!-- ============================================================== -->
<!-- JAVASCRIPT MODAL & PASSWORD TOGGLER -->
<!-- ============================================================== -->
<script>
  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = '🔒';
    } else {
      input.type = 'password';
      btn.textContent = '👁️';
    }
  }

  // Preview Avatar Tambah Anggota
  function previewAddUserAvatar(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('addUserAvatarPreview').src = e.target.result;
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  // Preview Avatar Edit Anggota
  function previewEditUserAvatar(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('editUserAvatarPreview').src = e.target.result;
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  // Modal Tambah Anggota
  function openAddUserModal() {
    const input = document.getElementById('addUserAvatarInput');
    if (input) input.value = '';
    document.getElementById('addUserAvatarPreview').src = 'https://api.dicebear.com/7.x/bottts/svg?seed=new';
    document.getElementById('addUserModal').classList.remove('hidden');
  }
  function closeAddUserModal() {
    document.getElementById('addUserModal').classList.add('hidden');
  }

  // Modal Edit Anggota
  function openEditUserModal(id, rawName, email, role, rawAvatar) {
    const name = decodeURIComponent(rawName);
    const avatar = rawAvatar ? decodeURIComponent(rawAvatar) : ('https://api.dicebear.com/7.x/bottts/svg?seed=' + encodeURIComponent(name));
    document.getElementById('editUserForm').action = `/admin/users/${id}/edit`;
    document.getElementById('editUserName').value = name;
    document.getElementById('editUserEmail').value = email;
    document.getElementById('editPasswordInput').value = '';
    document.getElementById('editUserAvatarPreview').src = avatar;
    const input = document.getElementById('editUserAvatarInput');
    if (input) input.value = '';

    if (role === 'admin') {
      document.getElementById('editRoleAdmin').checked = true;
    } else {
      document.getElementById('editRolePelanggan').checked = true;
    }

    document.getElementById('editUserModal').classList.remove('hidden');
  }
  function closeEditUserModal() {
    document.getElementById('editUserModal').classList.add('hidden');
  }

  // Modal Hapus Anggota
  function openDeleteUserModal(id, rawName, email) {
    const name = decodeURIComponent(rawName);
    document.getElementById('deleteUserForm').action = `/admin/users/${id}/delete`;
    document.getElementById('deleteUserName').textContent = name;
    document.getElementById('deleteUserEmail').textContent = email;
    document.getElementById('deleteUserModal').classList.remove('hidden');
  }
  function closeDeleteUserModal() {
    document.getElementById('deleteUserModal').classList.add('hidden');
  }
</script>
