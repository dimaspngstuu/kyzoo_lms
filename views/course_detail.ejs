<!-- Halaman Detail Kursus & Silabus -->

<div class="space-y-6">

  <!-- Header Banner Kursus -->
  <div class="bg-white rounded-[22px] border border-slate-100 p-6 shadow-sm flex flex-col md:flex-row items-center gap-6">
    <div class="w-full md:w-56 h-36 rounded-2xl overflow-hidden shrink-0 shadow-sm border border-slate-100">
      <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover">
    </div>

    <div class="flex-1 space-y-2 text-center md:text-left">
      <span class="px-3 py-1 rounded-full text-xs font-bold bg-violet-50 text-violet-700 border border-violet-100">
        <%= course.category %>
      </span>
      <h1 class="text-2xl font-black text-slate-900 tracking-tight"><%= course.title %></h1>
      <p class="text-xs sm:text-sm text-slate-500 leading-relaxed max-w-2xl"><%= course.description %></p>

      <div class="pt-2 flex items-center justify-center md:justify-start gap-4">
        <% if (firstLessonId) { %>
          <a href="/learn/<%= course.slug %>/<%= firstLessonId %>" class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#6c5dd3] hover:bg-violet-700 text-white rounded-xl font-bold text-xs sm:text-sm shadow-md shadow-violet-200 transition-all">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            <span>Mulai Nonton Tutorial</span>
          </a>
        <% } %>
        <a href="/courses" class="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold text-xs transition-colors">
          Kembali ke Katalog
        </a>
      </div>
    </div>
  </div>

  <!-- Silabus Bab & Materi Pelajaran (Struktur Hierarki Kursus) -->
  <div class="bg-white rounded-[22px] border border-slate-100 p-6 shadow-sm space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-slate-100">
      <div>
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <span>Struktur & Silabus Pembelajaran</span>
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">
          Hierarki materi kursus: <span class="font-bold text-slate-700"><%= course.title %></span> memiliki <span class="font-bold text-violet-600"><%= chapters.length %> Bab Turunan</span>.
        </p>
      </div>

      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
        <span class="w-2.5 h-2.5 rounded-full bg-violet-600"></span>
        <span><%= chapters.reduce((acc, ch) => acc + ch.lessons.length, 0) %> Total Video Tutorial</span>
      </div>
    </div>

    <div class="space-y-5">
      <% if (chapters.length === 0) { %>
        <div class="text-center py-8 text-slate-400 text-xs">
          Belum ada bab turunan materi untuk kursus ini.
        </div>
      <% } %>

      <% chapters.forEach((ch, idx) => { %>
        <div class="border border-slate-100 rounded-2xl p-4 sm:p-5 bg-slate-50/40 space-y-3">
          <!-- Induk Turunan Bab (Chapter Header) -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-xl bg-violet-100 text-violet-700 font-bold text-xs flex items-center justify-center shrink-0">
                <%= String(idx + 1).padStart(2, '0') %>
              </span>
              <div>
                <h3 class="text-sm font-bold text-slate-900"><%= ch.title %></h3>
                <span class="text-[11px] text-slate-400 font-medium">Turunan Bab <%= idx + 1 %></span>
              </div>
            </div>
            <span class="text-xs font-bold text-slate-600 bg-white px-2.5 py-1 rounded-lg border border-slate-200/60 shadow-xs">
              <%= ch.lessons.length %> Video Materi
            </span>
          </div>

          <!-- Turunan Lesson / Materi Video di dalam Bab -->
          <div class="space-y-2 pl-3 border-l-2 border-violet-200 ml-4 pt-1">
            <% ch.lessons.forEach((l, lIdx) => { %>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3.5 bg-white rounded-xl border border-slate-100 hover:border-violet-200 hover:shadow-xs transition-all gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="w-6 h-6 rounded-full flex items-center justify-center shrink-0 text-xs font-bold <%= l.is_completed ? 'bg-emerald-500 text-white' : 'border border-slate-300 text-slate-400' %>">
                    <%= l.is_completed ? '✓' : (lIdx + 1) %>
                  </span>
                  <div class="min-w-0">
                    <h4 class="text-xs font-bold text-slate-800 truncate"><%= l.title %></h4>
                    <div class="flex items-center gap-2 text-[10px] text-slate-400 mt-0.5">
                      <span class="text-violet-600 font-semibold uppercase"><%= l.video_source || 'Video' %></span>
                      <span>•</span>
                      <span><%= l.duration_minutes %> menit durasi</span>
                      <% if (l.is_completed) { %>
                        <span>•</span>
                        <span class="text-emerald-600 font-semibold">Telah Ditonton</span>
                      <% } %>
                    </div>
                  </div>
                </div>

                <a href="/learn/<%= course.slug %>/<%= l.id %>" class="self-end sm:self-auto px-3.5 py-1.5 bg-violet-50 hover:bg-[#6c5dd3] hover:text-white text-violet-700 rounded-lg text-xs font-bold transition-colors flex items-center gap-1.5 shrink-0">
                  <span>Putar Video</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path></svg>
                </a>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

</div>
