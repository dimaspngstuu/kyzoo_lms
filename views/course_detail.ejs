<!-- Halaman Detail Kursus: Silabus Berbasis Daftar Episode Tunggal (Tanpa Hierarki Bab) -->

<div class="space-y-6">

  <!-- Header Banner Kursus -->
  <div class="bg-white dark:bg-slate-900 rounded-[24px] border border-slate-100 dark:border-slate-800 p-6 sm:p-7 shadow-sm flex flex-col md:flex-row items-center gap-6 transition-colors">
    <div class="w-full md:w-56 h-36 rounded-2xl overflow-hidden shrink-0 shadow-sm border border-slate-100 dark:border-slate-800 bg-slate-100 dark:bg-slate-800">
      <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover">
    </div>

    <div class="flex-1 space-y-3 text-center md:text-left">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
        <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-50 dark:bg-brand-950/60 text-brand-600 dark:text-brand-400 border border-brand-100 dark:border-brand-900/60">
          <%= course.category %>
        </span>
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
          <%= lessons.length %> Total Episode
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight"><%= course.title %></h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed max-w-2xl"><%= course.description %></p>

      <!-- Progres Belajar Mini -->
      <% if (completedCount > 0) { %>
        <div class="pt-1 max-w-md">
          <div class="flex justify-between text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1.5">
            <span>Progres Belajar Anda</span>
            <span class="font-bold text-brand-600 dark:text-brand-400"><%= courseProgressPercent %>% (<%= completedCount %>/<%= lessons.length %> Episode)</span>
          </div>
          <div class="w-full bg-slate-100 dark:bg-slate-800 h-2 rounded-full overflow-hidden">
            <div id="courseDetailProgressBar" class="bg-brand-500 h-full rounded-full transition-all duration-500 shadow-dynamic-glow" data-progress="<%= courseProgressPercent || 0 %>"></div>
          </div>
        </div>
      <% } %>

      <div class="pt-2 flex items-center justify-center md:justify-start gap-3 flex-wrap">
        <% if (firstLessonId) { %>
          <a href="/learn/<%= course.slug %>/<%= firstLessonId %>" class="inline-flex items-center gap-2 px-6 py-2.5 bg-brand-500 hover:bg-brand-600 text-white rounded-xl font-bold text-xs sm:text-sm shadow-md shadow-dynamic-glow transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path></svg>
            <span><%= completedCount > 0 ? 'Lanjut Belajar Episode Berikutnya' : 'Mulai Belajar Materi' %></span>
          </a>
        <% } %>
        <a href="/courses" class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 font-semibold text-xs transition-colors">
          Kembali ke Katalog
        </a>
      </div>
    </div>
  </div>

  <!-- Silabus Berbasis Daftar Episode Tunggal (Linear & Langsung Dapat Diklik) -->
  <div class="bg-white dark:bg-slate-900 rounded-[24px] border border-slate-100 dark:border-slate-800 p-6 sm:p-7 shadow-sm space-y-5 transition-colors">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100 dark:border-slate-800">
      <div>
        <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
          <span>Daftar Episode Pembelajaran</span>
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          Materi disusun berurutan per episode. Klik langsung pada baris episode untuk membuka materi.
        </p>
      </div>

      <div class="flex items-center gap-2 text-xs font-bold text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/60 px-3 py-1.5 rounded-xl border border-brand-200/60 dark:border-brand-800/60 self-start sm:self-auto">
        <span class="w-2 h-2 rounded-full bg-brand-500"></span>
        <span><%= completedCount %> / <%= lessons.length %> Episode Selesai</span>
      </div>
    </div>

    <!-- List Linear Episode -->
    <div class="space-y-3">
      <% if (lessons.length === 0) { %>
        <div class="text-center py-12 text-slate-400 dark:text-slate-500 text-xs">
          Belum ada episode materi yang tersedia untuk kursus ini.
        </div>
      <% } %>

      <% lessons.forEach((l, idx) => { %>
        <!-- Setiap Baris Episode adalah Link Utuh (Klik di Mana Saja untuk Masuk) -->
        <a href="/learn/<%= course.slug %>/<%= l.id %>" 
           class="flex flex-col sm:flex-row sm:items-center justify-between p-4 sm:p-5 bg-white dark:bg-slate-900/60 rounded-2xl border border-slate-150 dark:border-slate-800 hover:border-brand-500/80 dark:hover:border-brand-500/80 hover:shadow-md hover:bg-slate-50/70 dark:hover:bg-slate-800/70 transition-all gap-4 group cursor-pointer block">
          
          <div class="flex items-center gap-4 min-w-0">
            <!-- Badge Nomor Episode / Checkmark Selesai -->
            <div class="w-11 h-11 rounded-2xl flex items-center justify-center shrink-0 font-extrabold text-xs transition-transform group-hover:scale-105 <%= l.is_completed ? 'bg-emerald-500 text-white shadow-sm' : 'bg-brand-50 dark:bg-brand-950/60 text-brand-600 dark:text-brand-400 border border-brand-100 dark:border-brand-900/60 group-hover:bg-brand-500 group-hover:text-white' %>">
              <% if (l.is_completed) { %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              <% } else { %>
                EP <%= String(idx + 1).padStart(2, '0') %>
              <% } %>
            </div>

            <!-- Judul & Metadata Episode -->
            <div class="min-w-0 space-y-1">
              <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-1">
                <%= l.title %>
              </h3>
              
              <div class="flex items-center gap-2.5 text-xs text-slate-400 dark:text-slate-500 flex-wrap">
                <span class="font-medium text-slate-500 dark:text-slate-400 inline-flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"></circle><polyline points="12 6 12 12 16 14" stroke-width="2" stroke-linecap="round"></polyline></svg>
                  <span><%= l.duration_minutes %> menit</span>
                </span>
                <span class="text-slate-300 dark:text-slate-700">•</span>
                
                <% if (l.video_url) { %>
                  <span class="text-brand-600 dark:text-brand-400 font-semibold inline-flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3" stroke-width="2" stroke-linejoin="round"></polygon></svg>
                    <span>Teori & Video</span>
                  </span>
                <% } else { %>
                  <span class="text-slate-600 dark:text-slate-400 font-semibold inline-flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    <span>Materi Bacaan</span>
                  </span>
                <% } %>

                <% if (l.attachment_url) { %>
                  <span class="text-slate-300 dark:text-slate-700">•</span>
                  <span class="text-amber-600 dark:text-amber-400 font-semibold inline-flex items-center gap-1">
                    <% if (l.attachment_type === 'image') { %>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" stroke-width="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21" stroke-width="2"></polyline></svg>
                      <span>Infografis</span>
                    <% } else if (l.attachment_type === 'ppt') { %>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path></svg>
                      <span>Slide PPT</span>
                    <% } else { %>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                      <span>Lampiran</span>
                    <% } %>
                  </span>
                <% } %>

                <% if (l.is_completed) { %>
                  <span class="text-slate-300 dark:text-slate-700">•</span>
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold inline-flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                    <span>Selesai</span>
                  </span>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Indikator Aksi Masuk Materi (Tanpa tombol sempit 'Putar Video') -->
          <div class="self-end sm:self-auto flex items-center gap-2 shrink-0">
            <% if (l.is_completed) { %>
              <span class="px-3.5 py-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 font-bold text-xs flex items-center gap-1.5 border border-emerald-100 dark:border-emerald-900/40">
                <span>Selesai</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              </span>
            <% } else { %>
              <span class="px-4 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 group-hover:bg-brand-500 group-hover:text-white font-bold text-xs transition-all flex items-center gap-1.5 shadow-xs">
                <span>Buka Materi</span>
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </span>
            <% } %>
          </div>

        </a>
      <% }) %>
    </div>
  </div>

</div>

<script>
  (function() {
    const pb = document.getElementById('courseDetailProgressBar');
    if (pb) {
      pb.style.width = (pb.getAttribute('data-progress') || 0) + '%';
    }
  })();
</script>
