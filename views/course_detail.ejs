<!-- Halaman Detail Kursus & Silabus -->

<div class="space-y-6">

  <!-- Header Banner Kursus -->
  <div class="bg-white rounded-[22px] border border-slate-100 p-6 shadow-sm flex flex-col md:flex-row items-center gap-6">
    <div class="w-full md:w-56 h-36 rounded-2xl overflow-hidden shrink-0 shadow-sm border border-slate-100">
      <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover">
    </div>

    <div class="flex-1 space-y-2 text-center md:text-left">
      <span class="px-3 py-1 rounded-full text-xs font-bold bg-violet-50 text-violet-700 border border-violet-100">
        <%= course.category %>
      </span>
      <h1 class="text-2xl font-black text-slate-900 tracking-tight"><%= course.title %></h1>
      <p class="text-xs sm:text-sm text-slate-500 leading-relaxed max-w-2xl"><%= course.description %></p>

      <div class="pt-2 flex items-center justify-center md:justify-start gap-4">
        <% if (firstLessonId) { %>
          <a href="/learn/<%= course.slug %>/<%= firstLessonId %>" class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#6c5dd3] hover:bg-violet-700 text-white rounded-xl font-bold text-xs sm:text-sm shadow-md shadow-violet-200 transition-all">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            <span>Mulai Nonton Tutorial</span>
          </a>
        <% } %>
        <a href="/courses" class="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold text-xs transition-colors">
          Kembali ke Katalog
        </a>
      </div>
    </div>
  </div>

  <!-- Silabus Bab & Materi Pelajaran -->
  <div class="bg-white rounded-[22px] border border-slate-100 p-6 shadow-sm space-y-4">
    <h2 class="text-base font-bold text-slate-900">Silabus Bab & Video Pembelajaran</h2>

    <div class="space-y-4">
      <% chapters.forEach((ch, idx) => { %>
        <div class="border border-slate-100 rounded-2xl p-4 bg-slate-50/50">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-bold text-slate-800"><%= ch.title %></h3>
            <span class="text-xs font-semibold text-slate-400"><%= ch.lessons.length %> Materi</span>
          </div>

          <div class="space-y-2">
            <% ch.lessons.forEach(l => { %>
              <div class="flex items-center justify-between p-3 bg-white rounded-xl border border-slate-100 hover:border-violet-200 transition-colors">
                <div class="flex items-center gap-3">
                  <span class="w-5 h-5 rounded-full flex items-center justify-center <%= l.is_completed ? 'bg-emerald-500 text-white' : 'border border-slate-300 text-transparent' %>">
                    ✓
                  </span>
                  <div>
                    <h4 class="text-xs font-bold text-slate-800"><%= l.title %></h4>
                    <span class="text-[10px] text-slate-400"><%= l.duration_minutes %> menit pembelajaran</span>
                  </div>
                </div>

                <a href="/learn/<%= course.slug %>/<%= l.id %>" class="px-3 py-1.5 bg-violet-50 hover:bg-violet-600 hover:text-white text-violet-700 rounded-lg text-xs font-bold transition-colors">
                  Putar Video
                </a>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

</div>
