<!-- Halaman Ruang Belajar Video & Checklist Materi (Course View) -->

<div class="space-y-6">

  <!-- Breadcrumbs & Navigasi Cepat -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
      <a href="/courses" class="hover:text-violet-600">Courses</a>
      <span>/</span>
      <a href="/courses/<%= course.slug %>" class="hover:text-violet-600 line-clamp-1"><%= course.title %></a>
      <span>/</span>
      <span class="text-slate-900 font-bold line-clamp-1"><%= activeLesson.title %></span>
    </div>

    <!-- Progress Kursus Mini -->
    <div class="flex items-center gap-3">
      <div class="text-xs font-bold text-slate-600">
        Progress: <span id="courseProgressText" class="text-violet-600"><%= courseProgressPercent %>%</span>
      </div>
      <div class="w-24 sm:w-32 bg-slate-100 h-2 rounded-full overflow-hidden">
        <div id="courseProgressBar" class="bg-[#6c5dd3] h-full rounded-full transition-all duration-500" style="width: <%= courseProgressPercent %>%"></div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- KOLOM KIRI (2 Kolom): Pemutar Video & Teks Panduan -->
    <div class="lg:col-span-2 space-y-5">
      
      <!-- Wadah Pemutar Video (Responsive Aspect Ratio 16:9) -->
      <div class="bg-slate-900 rounded-[22px] overflow-hidden shadow-lg border border-slate-800 relative aspect-video flex items-center justify-center">
        <% if (videoPlayerInfo.type === 'video') { %>
          <!-- HTML5 Video Player untuk File yang Diunggah Langsung -->
          <video controls autoplay class="w-full h-full object-cover rounded-[22px]">
            <source src="<%= videoPlayerInfo.embedUrl %>" type="video/mp4">
            Peramban Anda tidak mendukung pemutar video HTML5.
          </video>
        <% } else if (videoPlayerInfo.type === 'iframe') { %>
          <!-- Responsive Iframe Player untuk YouTube / Vimeo / Drive -->
          <iframe 
            src="<%= videoPlayerInfo.embedUrl %>" 
            title="<%= activeLesson.title %>" 
            class="w-full h-full border-0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen>
          </iframe>
        <% } else { %>
          <!-- Fallback jika video belum diunggah -->
          <div class="text-center p-6 text-slate-400">
            <svg class="w-12 h-12 mx-auto mb-2 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            <p class="text-sm font-semibold">Video tutorial untuk materi ini sedang disiapkan.</p>
          </div>
        <% } %>
      </div>

      <!-- Bar Aksi Materi (Tandai Selesai & Navigasi Sebelumnya/Selanjutnya) -->
      <div class="bg-white rounded-2xl border border-slate-100 p-4 shadow-sm flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <!-- Tombol Tandai Selesai (Checklist Interaktif) -->
        <button 
          id="btnToggleComplete" 
          onclick="toggleLessonCompletion(<%= activeLesson.id %>)" 
          class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm <%= activeLesson.is_completed ? 'bg-emerald-600 text-white hover:bg-emerald-700' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' %>">
          <svg id="completeCheckIcon" class="w-4 h-4 <%= activeLesson.is_completed ? 'block' : 'hidden' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>
          <span id="completeBtnText">
            <%= activeLesson.is_completed ? '✓ Materi Telah Diselesaikan' : 'Tandai Materi Selesai' %>
          </span>
        </button>

        <!-- Navigasi Next & Prev -->
        <div class="flex items-center justify-between sm:justify-end gap-2">
          <% if (prevLesson) { %>
            <a href="/learn/<%= course.slug %>/<%= prevLesson.id %>" class="flex-1 sm:flex-initial text-center justify-center px-3.5 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold text-xs transition-colors flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
              <span>Sebelumnya</span>
            </a>
          <% } %>

          <% if (nextLesson) { %>
            <a href="/learn/<%= course.slug %>/<%= nextLesson.id %>" class="flex-1 sm:flex-initial text-center justify-center px-4 py-2.5 rounded-xl bg-[#6c5dd3] text-white hover:bg-violet-700 font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm shadow-violet-200">
              <span>Materi Lanjut</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          <% } %>
        </div>
      </div>

      <!-- Teks Panduan & Rangkuman Materi -->
      <div class="bg-white rounded-[22px] border border-slate-100 p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <div>
            <h1 class="text-xl font-bold text-slate-900"><%= activeLesson.title %></h1>
            <p class="text-xs text-slate-400 font-medium mt-0.5">Estimasi Durasi: <%= activeLesson.duration_minutes %> menit</p>
          </div>
          <span class="text-xs font-bold px-3 py-1 bg-violet-50 text-violet-700 rounded-full border border-violet-100">
            <%= activeLesson.video_source === 'upload' ? 'Video Lokal MP4' : 'Streaming Online' %>
          </span>
        </div>

        <div class="prose prose-slate max-w-none text-sm leading-relaxed text-slate-600 space-y-3">
          <% if (activeLesson.content_text) { %>
            <p class="whitespace-pre-line"><%= activeLesson.content_text %></p>
          <% } else { %>
            <p class="text-slate-400 italic">Tidak ada catatan teks tambahan untuk video tutorial ini.</p>
          <% } %>
        </div>

        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-4 flex items-start gap-3 mt-4">
          <div class="w-7 h-7 rounded-lg bg-violet-100 text-violet-700 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div class="text-xs text-slate-600 leading-relaxed">
            <strong class="text-slate-800">Tips Penggunaan:</strong> Anda dapat menonton video berulang kali, mempercepat kecepatan playback, atau menandai selesai agar riwayat pembelajaran Anda tercatat di dashboard.
          </div>
        </div>
      </div>

    </div>

    <!-- KOLOM KANAN (1 Kolom): Daftar Silabus Bab & Materi Pelajaran -->
    <div class="space-y-4">
      <div class="bg-white rounded-[22px] border border-slate-100 p-5 shadow-sm sticky top-20">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
          <h3 class="text-sm font-bold text-slate-900">Daftar Modul & Materi</h3>
          <span class="text-xs font-bold text-violet-600 bg-violet-50 px-2 py-0.5 rounded-md">
            <%= completedCount %> / <%= totalLessons %> Selesai
          </span>
        </div>

        <div class="space-y-4 max-h-[70vh] overflow-y-auto pr-1">
          <% chapters.forEach((ch, chIdx) => { %>
            <div class="space-y-2">
              <div class="text-xs font-bold text-slate-800 flex items-center justify-between pb-1 border-b border-slate-100">
                <span class="flex items-center gap-1.5 truncate">
                  <span class="text-[10px] font-bold text-violet-700 bg-violet-100 px-1.5 py-0.5 rounded">Bab <%= chIdx + 1 %></span>
                  <span class="truncate"><%= ch.title %></span>
                </span>
                <span class="text-[10px] text-slate-400 font-semibold shrink-0 ml-1">(<%= ch.lessons.length %> video)</span>
              </div>

              <div class="space-y-1">
                <% ch.lessons.forEach((l) => { %>
                  <a href="/learn/<%= course.slug %>/<%= l.id %>" 
                     id="lessonItem-<%= l.id %>"
                     class="flex items-center justify-between p-2.5 rounded-xl text-xs transition-all <%= l.id === activeLesson.id ? 'bg-[#6c5dd3] text-white font-bold shadow-sm' : 'text-slate-600 hover:bg-slate-50 font-medium' %>">
                    
                    <div class="flex items-center gap-2.5 min-w-0">
                      <!-- Indikator Checkmark -->
                      <span id="badgeCheck-<%= l.id %>" class="w-4 h-4 rounded-full flex items-center justify-center shrink-0 <%= l.is_completed ? (l.id === activeLesson.id ? 'bg-white text-violet-600' : 'bg-emerald-500 text-white') : (l.id === activeLesson.id ? 'border border-white/60' : 'border border-slate-300') %>">
                        <% if (l.is_completed) { %>
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        <% } %>
                      </span>
                      <span class="truncate"><%= l.title %></span>
                    </div>

                    <span class="text-[10px] opacity-75 shrink-0 ml-2"><%= l.duration_minutes %>m</span>
                  </a>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>

      </div>
    </div>

  </div>

</div>

<script>
  async function toggleLessonCompletion(lessonId) {
    try {
      const response = await fetch('/api/progress/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lessonId })
      });
      const data = await response.json();

      if (data.success) {
        const btn = document.getElementById('btnToggleComplete');
        const icon = document.getElementById('completeCheckIcon');
        const text = document.getElementById('completeBtnText');
        const progressBar = document.getElementById('courseProgressBar');
        const progressText = document.getElementById('courseProgressText');

        if (data.isCompleted) {
          btn.className = "flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm bg-emerald-600 text-white hover:bg-emerald-700";
          icon.classList.remove('hidden');
          text.textContent = "✓ Materi Telah Diselesaikan";
          showToast("Materi berhasil ditandai selesai!");
        } else {
          btn.className = "flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm bg-slate-100 text-slate-700 hover:bg-slate-200";
          icon.classList.add('hidden');
          text.textContent = "Tandai Materi Selesai";
          showToast("Status materi dikembalikan belum selesai.");
        }

        if (progressBar && progressText) {
          progressBar.style.width = data.coursePercent + '%';
          progressText.textContent = data.coursePercent + '%';
        }

        // Update badge sidebar
        const badge = document.getElementById('badgeCheck-' + lessonId);
        if (badge) {
          if (data.isCompleted) {
            badge.className = "w-4 h-4 rounded-full flex items-center justify-center shrink-0 bg-white text-violet-600";
            badge.innerHTML = `<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>`;
          } else {
            badge.className = "w-4 h-4 rounded-full flex items-center justify-center shrink-0 border border-white/60";
            badge.innerHTML = "";
          }
        }
      }
    } catch (err) {
      console.error(err);
      showToast("Gagal memperbarui progres materi.", "error");
    }
  }
</script>
