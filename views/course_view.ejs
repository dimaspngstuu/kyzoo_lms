<!-- Halaman Ruang Belajar: Materi Teori Terstruktur di Atas, Video Opsional di Bawah (Course View) -->

<div class="space-y-6">

  <!-- Breadcrumbs & Navigasi Cepat (Mendukung Dark Mode & Tema Dinamis) -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-slate-900 p-4 sm:p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-2xs transition-colors">
    <div class="flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400 flex-wrap">
      <a href="/courses" class="hover:text-slate-900 dark:hover:text-white transition-colors">Courses</a>
      <svg class="w-3 h-3 text-slate-300 dark:text-slate-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      <a href="/courses/<%= course.slug %>" class="hover:text-slate-900 dark:hover:text-white line-clamp-1 transition-colors"><%= course.title %></a>
      <svg class="w-3 h-3 text-slate-300 dark:text-slate-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      <span class="text-slate-900 dark:text-white font-semibold line-clamp-1"><% if (typeof currentEpisodeIndex !== 'undefined') { %>EP <%= String(currentEpisodeIndex + 1).padStart(2, '0') %>: <% } %><%= activeLesson.title %></span>
    </div>

    <!-- Progress Kursus Mini -->
    <div class="flex items-center gap-3 shrink-0">
      <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">
        Progress: <span id="courseProgressText" class="text-slate-900 dark:text-white font-extrabold"><%= courseProgressPercent %>%</span>
      </div>
      <div class="w-24 sm:w-32 bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
        <div id="courseProgressBar" class="bg-slate-900 dark:bg-white h-full rounded-full transition-all duration-500" data-progress="<%= courseProgressPercent || 0 %>"></div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

    <!-- KOLOM KIRI (2 Kolom): Materi Teori Utama di Atas, Video Opsional di Bawah -->
    <div class="lg:col-span-2 space-y-5">
      
      <!-- CARD UTAMA: MATERI TULISAN / TEORI -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-4 sm:p-8 shadow-2xs space-y-6 transition-colors">
        
        <!-- Header Materi: Kategori, Status Video, Estimasi Durasi, & Judul Utama -->
        <div class="border-b border-slate-100 dark:border-slate-800 pb-5">
          <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
            <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-md flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
              <span>EPISODE <%= typeof currentEpisodeIndex !== 'undefined' ? String(currentEpisodeIndex + 1).padStart(2, '0') : '' %></span>
            </span>
            
            <div class="flex items-center gap-2 flex-wrap">
              <% if (videoPlayerInfo && videoPlayerInfo.type !== 'none') { %>
                <span class="text-[11px] font-medium px-2.5 py-1 bg-slate-50 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 rounded-md border border-slate-200/60 dark:border-slate-700 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                  <span>Video Tutorial</span>
                </span>
              <% } else { %>
                <span class="text-[11px] font-medium px-2.5 py-1 bg-slate-50 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 rounded-md border border-slate-200/60 dark:border-slate-700 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                  <span>Panduan Teks</span>
                </span>
              <% } %>
              
              <span id="lessonHeaderDuration" class="text-xs text-slate-400 dark:text-slate-500 font-normal flex items-center gap-1 font-mono">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span><%= activeLesson.duration_minutes %> menit</span>
              </span>
            </div>
          </div>

          <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-snug">
            <%= activeLesson.title %>
          </h1>
        </div>

        <!-- 1. SEKSI VIDEO TUTORIAL (OPSIONAL: Tampil di atas jika materi memiliki video) -->
        <% if (videoPlayerInfo && videoPlayerInfo.type !== 'none') { %>
          <div class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-brand-50 dark:bg-brand-950/60 text-brand-600 dark:text-brand-400 flex items-center justify-center shrink-0 border border-brand-100 dark:border-brand-900/60">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path></svg>
                </div>
                <div>
                  <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <span>Langsung aja ditonton videonya:</span>
                    <span class="text-[10px] font-bold text-slate-400 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-full uppercase tracking-wider">Opsional</span>
                  </h3>
                  <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                    Saksikan video di bawah ini untuk melihat demonstrasi dan implementasi praktiknya:
                  </p>
                </div>
              </div>

              <span class="self-start sm:self-auto text-[11px] font-semibold px-2.5 py-1 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-lg">
                <%= activeLesson.video_source === 'upload' ? 'Video Lokal MP4' : 'Streaming Online' %>
              </span>
            </div>

            <!-- Wadah Pemutar Video (Responsive Aspect Ratio 16:9) -->
            <div class="bg-slate-900 rounded-[22px] overflow-hidden shadow-lg border border-slate-800 relative aspect-video flex items-center justify-center">
              <% if (videoPlayerInfo.type === 'video') { %>
                <!-- HTML5 Video Player untuk File yang Diunggah Langsung -->
                <video id="localLessonVideo" controls class="w-full h-full object-cover rounded-[22px]">
                  <source src="<%= videoPlayerInfo.embedUrl %>" type="video/mp4">
                  Peramban Anda tidak mendukung pemutar video HTML5.
                </video>
              <% } else if (videoPlayerInfo.type === 'iframe') { %>
                <!-- Responsive Iframe Player untuk YouTube / Vimeo / Drive -->
                <iframe 
                  id="lessonIframePlayer"
                  src="<%= videoPlayerInfo.embedUrl %>" 
                  title="<%= activeLesson.title %>" 
                  class="w-full h-full border-0" 
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                  allowfullscreen>
                </iframe>
              <% } %>
            </div>
          </div>
        <% } %>

        <!-- 2. SEKSI LAMPIRAN BERKAS / GAMBAR / SLIDE PPT (OPSIONAL: Tampil jika disematkan) -->
        <% if (activeLesson.attachment_url && activeLesson.attachment_url.trim()) { %>
          <div class="space-y-4 <%= (videoPlayerInfo && videoPlayerInfo.type !== 'none') ? 'pt-6 border-t border-slate-100 dark:border-slate-800' : '' %>">
            
            <% if (activeLesson.attachment_type === 'image') { %>
              <%
                let displayImgTitle = (activeLesson.attachment_name || '').trim();
                if (!displayImgTitle || displayImgTitle.toLowerCase().includes('gemini_generated') || displayImgTitle.match(/\.(png|jpg|jpeg|webp|svg|gif)$/i)) {
                  displayImgTitle = 'Infografis & Diagram Materi';
                }
              %>
              <!-- Lampiran Gambar / Diagram Infografis -->
              <div class="space-y-3">
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center shrink-0 border border-slate-200/70 dark:border-slate-700">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                    <div class="min-w-0">
                      <h3 class="text-xs sm:text-sm md:text-base font-bold text-slate-900 dark:text-white truncate">
                        <%= displayImgTitle %>
                      </h3>
                      <p class="text-[10px] sm:text-[11px] text-slate-400 truncate">Infografis & diagram visual materi</p>
                    </div>
                  </div>
                  <a 
                    href="<%= activeLesson.attachment_url %>" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="shrink-0 px-2.5 sm:px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-lg flex items-center gap-1.5 transition-all whitespace-nowrap shadow-2xs">
                    <span class="hidden sm:inline">Buka Resolusi Penuh</span>
                    <span class="sm:hidden">Lihat HD</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                  </a>
                </div>
                <!-- Box Gambar: Lebar Penuh (w-full) & Responsif Maksimal di HP -->
                <div class="rounded-2xl overflow-hidden border border-slate-200/80 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50 p-1 sm:p-2 text-center group">
                  <a href="<%= activeLesson.attachment_url %>" target="_blank" rel="noopener noreferrer" class="block cursor-zoom-in" title="Ketuk untuk melihat gambar resolusi penuh">
                    <img 
                      src="<%= activeLesson.attachment_url %>" 
                      alt="<%= displayImgTitle %>" 
                      class="w-full h-auto max-h-[720px] rounded-xl object-contain mx-auto shadow-xs transition-transform duration-200 group-hover:scale-[1.01]" 
                      loading="lazy" 
                    />
                  </a>
                </div>
              </div>

            <% } else { %>
              <!-- Lampiran Slide Presentasi PPT / PDF / Dokumen -->
              <div class="p-4 sm:p-5 rounded-2xl bg-amber-50/60 dark:bg-amber-950/20 border border-amber-200/80 dark:border-amber-900/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-amber-500/10 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/20 flex items-center justify-center shrink-0">
                    <% if (activeLesson.attachment_type === 'ppt') { %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path></svg>
                    <% } else if (activeLesson.attachment_type === 'pdf') { %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    <% } else { %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                    <% } %>
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-300 uppercase tracking-wider">
                        <%= activeLesson.attachment_type === 'ppt' ? 'Slide Presentasi PPT' : (activeLesson.attachment_type === 'pdf' ? 'Dokumen PDF' : 'Berkas Lampiran') %>
                      </span>
                      <span class="text-[10px] font-semibold text-slate-400">Materi Pendukung</span>
                    </div>
                    <h4 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white mt-1">
                      <%= activeLesson.attachment_name || 'Slide Materi Pembelajaran' %>
                    </h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                      Buka atau unduh file materi ini untuk menyimak rangkuman poin secara terstruktur.
                    </p>
                  </div>
                </div>

                <a 
                  href="<%= activeLesson.attachment_url %>" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="shrink-0 px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs rounded-xl flex items-center justify-center gap-2 shadow-xs transition-all hover:scale-[1.02]">
                  <span>Unduh / Buka Berkas</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
              </div>
            <% } %>

          </div>
        <% } %>

        <!-- 3. ISI KONTEN TEORI TULISAN UTAMA (Tampil di Bawah Video / Gambar) -->
        <div class="prose-container space-y-4 <%= ((videoPlayerInfo && videoPlayerInfo.type !== 'none') || (activeLesson.attachment_url && activeLesson.attachment_url.trim())) ? 'pt-6 border-t border-slate-100 dark:border-slate-800' : 'pt-1' %>">
          <% if (typeof renderedContent !== 'undefined' && renderedContent) { %>
            <%- renderedContent %>
          <% } else if (activeLesson.content_text) { %>
            <p class="text-sm sm:text-base leading-relaxed text-slate-700 dark:text-slate-300 whitespace-pre-line">
              <%= activeLesson.content_text %>
            </p>
          <% } else { %>
            <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800 text-center text-slate-400 dark:text-slate-500 italic text-sm">
              Belum ada rangkuman teori tertulis untuk materi ini.
            </div>
          <% } %>
        </div>

        <!-- Tips Penggunaan / Catatan Belajar -->
        <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60 rounded-xl p-4 sm:p-5 flex items-start gap-3 mt-6">
          <div class="w-6 h-6 rounded-md bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
            <strong class="text-slate-900 dark:text-white font-semibold">Tips Pembelajaran:</strong> Simak materi di atas, lalu pelajari ringkasan teori pendukung di bawahnya. Klik tombol <em>Tandai Materi Selesai</em> di bawah agar kemajuan belajar Anda tercatat di dashboard.
          </div>
        </div>

      </div>

      <!-- BAR AKSI MATERI: TANDAI SELESAI & NAVIGASI SEBELUMNYA / SELANJUTNYA -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-4 shadow-2xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 transition-colors">
        <!-- Tombol Tandai Selesai (Checklist Interaktif) -->
        <button 
          id="btnToggleComplete" 
          data-lesson-id="<%= activeLesson.id %>"
          onclick="toggleLessonCompletion(Number(this.getAttribute('data-lesson-id')))" 
          class="flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-xs sm:text-sm transition-all shadow-2xs <%= activeLesson.is_completed ? 'bg-emerald-600 text-white hover:bg-emerald-700' : 'bg-slate-900 hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100 text-white' %>">
          <svg id="completeCheckIcon" class="w-4 h-4 <%= activeLesson.is_completed ? 'block' : 'hidden' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>
          <span id="completeBtnText">
            <%= activeLesson.is_completed ? 'Materi Selesai Dipelajari' : 'Tandai Materi Selesai' %>
          </span>
        </button>

        <!-- Navigasi Next & Prev -->
        <div class="flex items-center justify-between sm:justify-end gap-2">
          <% if (prevLesson) { %>
            <a href="/learn/<%= course.slug %>/<%= prevLesson.id %>" class="flex-1 sm:flex-initial text-center justify-center px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 font-medium text-xs transition-colors flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
              <span>Sebelumnya</span>
            </a>
          <% } %>

          <% if (nextLesson) { %>
            <a href="/learn/<%= course.slug %>/<%= nextLesson.id %>" class="flex-1 sm:flex-initial text-center justify-center px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100 text-white font-semibold text-xs transition-colors flex items-center gap-1.5 shadow-2xs">
              <span>Materi Lanjut</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          <% } %>
        </div>
      </div>

    </div>

    <!-- KOLOM KANAN (1 Kolom): Daftar Episode Pembelajaran (Linear Tanpa Bab) -->
    <div class="space-y-4">
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-2xs sticky top-20 transition-colors">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100 dark:border-slate-800">
          <h3 class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
            <span>Daftar Episode</span>
          </h3>
          <span class="text-xs font-semibold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 rounded-md">
            <%= completedCount %> / <%= totalLessons %> Selesai
          </span>
        </div>

        <div class="space-y-1 max-h-[72vh] overflow-y-auto pr-1">
          <% (typeof lessons !== 'undefined' ? lessons : []).forEach((l, idx) => { %>
            <a href="/learn/<%= course.slug %>/<%= l.id %>" 
               id="lessonItem-<%= l.id %>"
               class="flex items-center justify-between p-2.5 rounded-xl text-xs transition-all <%= l.id === activeLesson.id ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-semibold shadow-2xs' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white font-medium' %>">
              
              <div class="flex items-center gap-2.5 min-w-0">
                <!-- Indikator Checkmark / Nomor EP -->
                <span id="badgeCheck-<%= l.id %>" data-ep-num="<%= idx + 1 %>" class="w-5 h-5 rounded-md flex items-center justify-center shrink-0 text-[10px] font-semibold <%= l.is_completed ? (l.id === activeLesson.id ? 'bg-white text-slate-900 dark:bg-slate-900 dark:text-white' : 'bg-emerald-500 text-white') : (l.id === activeLesson.id ? 'bg-white/20 text-white dark:bg-slate-900/20 dark:text-slate-900' : 'bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400') %>">
                  <% if (l.is_completed) { %>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                  <% } else { %>
                    <%= idx + 1 %>
                  <% } %>
                </span>
                <span class="truncate">
                  <span class="opacity-75 font-semibold mr-1">EP <%= String(idx + 1).padStart(2, '0') %>:</span>
                  <span><%= l.title %></span>
                </span>
              </div>

              <div class="flex items-center gap-1.5 shrink-0 ml-2">
                <% if (l.attachment_url) { %>
                  <span title="<%= l.attachment_name || 'Lampiran Berkas' %>" class="opacity-60">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                  </span>
                <% } %>
                <span id="lessonDuration-<%= l.id %>" class="text-[10px] opacity-75 font-mono"><%= l.duration_minutes %>m</span>
              </div>
            </a>
          <% }) %>
        </div>

      </div>
    </div>

  </div>

</div>

<!-- Data Lesson JSON Client (Aman dari parser JS linter) -->
<script type="application/json" id="activeLessonJson">
<%- JSON.stringify({ id: activeLesson.id, duration_minutes: activeLesson.duration_minutes || 0 }) %>
</script>

<script>
  async function toggleLessonCompletion(lessonId) {
    try {
      const response = await fetch('/api/progress/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lessonId })
      });
      const data = await response.json();

      if (data.success) {
        const btn = document.getElementById('btnToggleComplete');
        const icon = document.getElementById('completeCheckIcon');
        const text = document.getElementById('completeBtnText');
        const progressBar = document.getElementById('courseProgressBar');
        const progressText = document.getElementById('courseProgressText');

        if (data.isCompleted) {
          btn.className = "flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm bg-emerald-600 text-white hover:bg-emerald-700";
          icon.classList.remove('hidden');
          text.textContent = "Materi Selesai Dipelajari";
          showToast("Materi berhasil ditandai selesai!");
        } else {
          btn.className = "flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700";
          icon.classList.add('hidden');
          text.textContent = "Tandai Materi Selesai";
          showToast("Status materi dikembalikan belum selesai.");
        }

        if (progressBar && progressText) {
          progressBar.style.width = data.coursePercent + '%';
          progressText.textContent = data.coursePercent + '%';
        }

        // Update badge sidebar
        const badge = document.getElementById('badgeCheck-' + lessonId);
        if (badge) {
          const epNum = badge.getAttribute('data-ep-num') || '';
          if (data.isCompleted) {
            badge.className = "w-5 h-5 rounded-md flex items-center justify-center shrink-0 text-[10px] font-bold " + 
              (lessonId === currentActiveLessonId ? "bg-white text-brand-600 shadow-xs" : "bg-emerald-500 text-white");
            badge.innerHTML = `<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>`;
          } else {
            badge.className = "w-5 h-5 rounded-md flex items-center justify-center shrink-0 text-[10px] font-bold " + 
              (lessonId === currentActiveLessonId ? "bg-white/25 text-white" : "bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400");
            badge.innerHTML = epNum;
          }
        }
      }
    } catch (err) {
      console.error(err);
      showToast("Gagal memperbarui progres materi.", "error");
    }
  }

  // ==============================================================
  // SISTEM DETEKSI & SINKRONISASI OTOMATIS DURASI VIDEO (YT & LOKAL)
  // ==============================================================
  // Inisialisasi data materi aktif aman tanpa error linter
  const activeLessonData = JSON.parse(document.getElementById('activeLessonJson').textContent || '{}');
  const currentActiveLessonId = Number(activeLessonData.id || 0);
  let currentDbMinutes = Number(activeLessonData.duration_minutes || 0);
  let hasSyncedDuration = false;

  // Inisialisasi progress bar saat pertama kali dimuat
  (function() {
    const pb = document.getElementById('courseProgressBar');
    if (pb) {
      pb.style.width = (pb.getAttribute('data-progress') || 0) + '%';
    }
  })();

  function syncDetectedDuration(lessonId, totalSeconds) {
    if (!totalSeconds || totalSeconds <= 0 || hasSyncedDuration) return;
    const minutes = Math.max(1, Math.round(totalSeconds / 60));
    const minsFormatted = Math.floor(totalSeconds / 60);
    const secsFormatted = Math.floor(totalSeconds % 60);
    const timeDisplay = `${minsFormatted}:${secsFormatted < 10 ? '0' : ''}${secsFormatted}`;

    // 1. Update Teks di Header Panduan Belajar
    const headerDur = document.getElementById('lessonHeaderDuration');
    if (headerDur) {
      headerDur.textContent = `⏱️ ${minutes} menit (${timeDisplay})`;
    }

    // 2. Update Badge di Sidebar Daftar Modul & Materi
    const durationBadge = document.getElementById('lessonDuration-' + lessonId);
    if (durationBadge) {
      durationBadge.textContent = minutes + 'm';
      durationBadge.title = `Durasi video asli: ${timeDisplay}`;
    }

    // 3. Kirim ke Database jika berbeda dari data awal
    if (minutes !== currentDbMinutes) {
      hasSyncedDuration = true;
      fetch(`/api/lessons/${lessonId}/sync-duration`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ duration_minutes: minutes })
      })
      .then(res => res.json())
      .then(res => {
        if (res.success) {
          currentDbMinutes = minutes;
          console.log(`[Kyzoo LMS] Durasi video berhasil disinkronkan ke DB: ${minutes} menit (${timeDisplay})`);
        }
      })
      .catch(err => console.error('Gagal sinkronisasi durasi video:', err));
    }
  }

  // A. Deteksi untuk Video Lokal (HTML5 <video>)
  const localVideoEl = document.getElementById('localLessonVideo');
  if (localVideoEl) {
    localVideoEl.addEventListener('loadedmetadata', function() {
      if (localVideoEl.duration && localVideoEl.duration > 0) {
        syncDetectedDuration(currentActiveLessonId, localVideoEl.duration);
      }
    });
    if (localVideoEl.duration && localVideoEl.duration > 0) {
      syncDetectedDuration(currentActiveLessonId, localVideoEl.duration);
    }
  }

  // B. Deteksi untuk YouTube via postMessage Broadcast (Instan & Tanpa API Key)
  window.addEventListener('message', function(event) {
    try {
      const data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
      if (data && data.info && typeof data.info.duration === 'number' && data.info.duration > 0) {
        syncDetectedDuration(currentActiveLessonId, data.info.duration);
      }
    } catch (e) {}
  });

  // C. Deteksi untuk YouTube via IFrame Player API
  let ytPlayer = null;
  let ytCheckTimer = null;
  let ytCheckAttempts = 0;

  function initYtPlayerListener() {
    const iframeEl = document.getElementById('lessonIframePlayer');
    if (!iframeEl || typeof YT === 'undefined' || !YT.Player) return;

    try {
      ytPlayer = new YT.Player('lessonIframePlayer', {
        events: {
          'onReady': onYtReady,
          'onStateChange': onYtStateChange
        }
      });
    } catch (e) {}
  }

  function checkYtDuration(player) {
    if (!player || typeof player.getDuration !== 'function') return false;
    const dur = player.getDuration();
    if (dur && dur > 0) {
      syncDetectedDuration(currentActiveLessonId, dur);
      if (ytCheckTimer) clearInterval(ytCheckTimer);
      return true;
    }
    return false;
  }

  function onYtReady(event) {
    if (!checkYtDuration(event.target)) {
      ytCheckTimer = setInterval(() => {
        ytCheckAttempts++;
        if (checkYtDuration(event.target) || ytCheckAttempts > 8) {
          clearInterval(ytCheckTimer);
        }
      }, 1000);
    }
  }

  function onYtStateChange(event) {
    checkYtDuration(event.target);
  }

  window.onYouTubeIframeAPIReady = initYtPlayerListener;
  if (window.YT && window.YT.Player) {
    initYtPlayerListener();
  }

  // ==============================================================
  // KOTAK PROMPT / KODE (SALIN & SIMPAN BOOKMARK)
  // ==============================================================
  const SAVED_PROMPTS_KEY = 'kyzoo_saved_prompts';

  function getSavedPromptsMap() {
    try {
      return JSON.parse(localStorage.getItem(SAVED_PROMPTS_KEY) || '{}');
    } catch (e) {
      return {};
    }
  }

  function applyBookmarkBtnState(btn, isSaved) {
    if (!btn) return;
    const icon = btn.querySelector('.kyzoo-bookmark-icon');
    const text = btn.querySelector('.kyzoo-bookmark-text');

    if (isSaved) {
      btn.className = 'px-2.5 py-1 rounded-lg border border-amber-200 dark:border-amber-700/70 bg-amber-50/70 dark:bg-amber-950/40 text-amber-800 dark:text-amber-200 text-[11px] font-semibold inline-flex items-center gap-1.5 transition-all cursor-pointer shadow-2xs';
      if (icon) {
        icon.setAttribute('fill', 'currentColor');
        icon.classList.remove('text-slate-400');
        icon.classList.add('text-amber-500');
      }
      if (text) text.textContent = 'Tersimpan';
    } else {
      btn.className = 'px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100/70 dark:hover:bg-slate-700 text-[11px] font-semibold inline-flex items-center gap-1.5 transition-all cursor-pointer shadow-2xs';
      if (icon) {
        icon.setAttribute('fill', 'none');
        icon.classList.remove('text-amber-500');
        icon.classList.add('text-slate-400');
      }
      if (text) text.textContent = 'Simpan';
    }
  }

  function togglePromptBookmark(btn) {
    const box = btn.closest('.kyzoo-prompt-box');
    if (!box) return;
    const promptId = box.getAttribute('data-prompt-id');
    if (!promptId) return;

    const map = getSavedPromptsMap();
    const nextState = !Boolean(map[promptId]);
    if (nextState) {
      map[promptId] = true;
    } else {
      delete map[promptId];
    }

    try {
      localStorage.setItem(SAVED_PROMPTS_KEY, JSON.stringify(map));
    } catch (e) {}

    applyBookmarkBtnState(btn, nextState);
    if (typeof showToast === 'function') {
      showToast(nextState ? 'Prompt ditandai Tersimpan!' : 'Status Tersimpan dihapus.');
    }
  }

  function copyPromptBlock(btn) {
    const box = btn.closest('.kyzoo-prompt-box');
    if (!box) return;
    const contentEl = box.querySelector('.kyzoo-prompt-content');
    const textToCopy = contentEl ? contentEl.textContent : '';
    if (!textToCopy) return;

    const onCopied = () => {
      const textSpan = btn.querySelector('.kyzoo-copy-text');
      const iconSvg = btn.querySelector('.kyzoo-copy-icon');
      const origHtml = iconSvg ? iconSvg.innerHTML : '';

      if (textSpan) textSpan.textContent = 'Tersalin!';
      if (iconSvg) {
        iconSvg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>';
      }
      btn.classList.add('border-emerald-300', 'bg-emerald-50/70', 'text-emerald-700');

      if (typeof showToast === 'function') {
        showToast('Isi prompt berhasil disalin!');
      }

      setTimeout(() => {
        if (textSpan) textSpan.textContent = 'Salin';
        if (iconSvg && origHtml) iconSvg.innerHTML = origHtml;
        btn.classList.remove('border-emerald-300', 'bg-emerald-50/70', 'text-emerald-700');
      }, 2000);
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(textToCopy).then(onCopied).catch(() => fallbackCopyText(textToCopy, onCopied));
    } else {
      fallbackCopyText(textToCopy, onCopied);
    }
  }

  function fallbackCopyText(text, cb) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    try {
      document.execCommand('copy');
      if (cb) cb();
    } catch (e) {}
    ta.remove();
  }

  // Pulihkan status Tersimpan saat halaman dimuat
  (function initPromptBookmarks() {
    const map = getSavedPromptsMap();
    document.querySelectorAll('.kyzoo-prompt-box').forEach(box => {
      const promptId = box.getAttribute('data-prompt-id');
      const btn = box.querySelector('[data-prompt-bookmark-btn]');
      if (promptId && btn && map[promptId]) {
        applyBookmarkBtnState(btn, true);
      }
    });
  })();
</script>
