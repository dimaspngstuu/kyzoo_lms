<!-- Halaman Katalog Semua Kursus -->

<div class="space-y-6">

  <!-- Header & Pencarian -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-slate-900 tracking-tight">Katalog Modul & Tutorial</h2>
      <p class="text-xs text-slate-500 mt-1">Pilih materi yang ingin Anda pelajari untuk menguasai produk dengan cepat.</p>
    </div>

    <!-- Filter Kategori Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-1">
      <a href="/courses" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all <%= !currentCategory ? 'bg-[#6c5dd3] text-white shadow-sm shadow-violet-200' : 'bg-white text-slate-600 border border-slate-200/80 hover:bg-slate-50' %>">
        Semua
      </a>
      <% categories.forEach(cat => { %>
        <a href="/courses?category=<%= encodeURIComponent(cat) %>" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all <%= currentCategory === cat ? 'bg-[#6c5dd3] text-white shadow-sm shadow-violet-200' : 'bg-white text-slate-600 border border-slate-200/80 hover:bg-slate-50' %>">
          <%= cat %>
        </a>
      <% }) %>
    </div>
  </div>

  <!-- Grid Kursus -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% courses.forEach(course => { %>
      <div class="bg-white rounded-[22px] border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-all flex flex-col group">
        <!-- Thumbnail Kursus -->
        <div class="h-44 w-full relative overflow-hidden bg-slate-100">
          <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
          <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-[10px] font-bold bg-white/90 backdrop-blur-md text-slate-800 shadow-sm">
            <%= course.category %>
          </span>
          <span class="absolute bottom-3 right-3 px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-900/80 backdrop-blur-md text-white shadow-sm">
            <%= course.total_lessons %> Materi Video
          </span>
        </div>

        <!-- Konten Kartu -->
        <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
          <div>
            <div class="text-[10px] font-bold text-violet-600 uppercase tracking-wider mb-1"><%= course.code %></div>
            <h3 class="text-base font-bold text-slate-900 group-hover:text-violet-600 transition-colors line-clamp-1">
              <%= course.title %>
            </h3>
            <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
              <%= course.description %>
            </p>
          </div>

          <!-- Progress Bar & Tombol Belajar -->
          <div class="space-y-3 pt-3 border-t border-slate-100">
            <div>
              <div class="flex justify-between text-xs font-semibold text-slate-500 mb-1">
                <span>Progres Belajar</span>
                <span class="font-bold text-slate-800"><%= course.percent %>%</span>
              </div>
              <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                <div class="bg-[#6c5dd3] h-full rounded-full transition-all duration-500" style="<%= 'width: ' + (course.percent || 0) + '%;' %>"></div>
              </div>
            </div>

            <a href="/courses/<%= course.slug %>" class="w-full inline-flex items-center justify-center gap-2 py-2.5 bg-violet-50 text-violet-700 hover:bg-[#6c5dd3] hover:text-white rounded-xl font-bold text-xs transition-colors">
              <span>Buka Materi</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

</div>
