<!-- Halaman Katalog Semua Kursus -->

<div class="space-y-6">

  <!-- Header & Pencarian -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Katalog Modul & Tutorial</h2>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">Pilih materi yang ingin Anda pelajari untuk menguasai produk dengan cepat.</p>
    </div>

    <!-- Filter Kategori Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-1">
      <a href="/courses" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all <%= !currentCategory ? 'bg-brand-500 text-white shadow-sm shadow-dynamic-glow' : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200/80 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800' %>">
        Semua
      </a>
      <% categories.forEach(cat => { %>
        <a href="/courses?category=<%= encodeURIComponent(cat) %>" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all <%= currentCategory === cat ? 'bg-brand-500 text-white shadow-sm shadow-dynamic-glow' : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200/80 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800' %>">
          <%= cat %>
        </a>
      <% }) %>
    </div>
  </div>

  <!-- State Kosong / Grid Kursus -->
  <% if (courses.length === 0) { %>
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 p-12 text-center shadow-xs">
      <div class="w-14 h-14 rounded-2xl bg-brand-50 dark:bg-brand-950/60 text-brand-600 dark:text-brand-400 flex items-center justify-center mx-auto mb-4 border border-brand-100 dark:border-brand-900/60">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
      </div>
      <h3 class="text-base font-bold text-slate-800 dark:text-white">Belum Ada Kursus Ditemukan</h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-sm mx-auto">
        Materi kursus sedang dipersiapkan atau belum dipublikasikan oleh admin.
      </p>
    </div>
  <% } else { %>
  <!-- Grid Kursus -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% courses.forEach(course => { %>
      <div class="bg-white dark:bg-slate-900 rounded-[22px] border border-slate-100 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-md transition-all flex flex-col group">
        <!-- Thumbnail Kursus -->
        <div class="h-44 w-full relative overflow-hidden bg-slate-100 dark:bg-slate-800">
          <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
          <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-[10px] font-bold bg-white/90 dark:bg-slate-900/90 backdrop-blur-md text-slate-800 dark:text-slate-200 shadow-sm border border-slate-200/40 dark:border-slate-700/40">
            <%= course.category %>
          </span>
          <span class="absolute bottom-3 right-3 px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-900/80 backdrop-blur-md text-white shadow-sm">
            <%= course.total_lessons %> Materi
          </span>
        </div>

        <!-- Konten Kartu -->
        <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
          <div>
            <div class="text-[10px] font-bold text-brand-600 dark:text-brand-400 uppercase tracking-wider mb-1"><%= course.code %></div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-1">
              <%= course.title %>
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 line-clamp-2 leading-relaxed">
              <%= course.description %>
            </p>
          </div>

          <!-- Progress Bar & Tombol Belajar -->
          <div class="space-y-3 pt-3 border-t border-slate-100 dark:border-slate-800">
            <div>
              <div class="flex justify-between text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">
                <span>Progres Belajar</span>
                <span class="font-bold text-slate-800 dark:text-white"><%= course.percent %>%</span>
              </div>
              <div class="w-full bg-slate-100 dark:bg-slate-800 h-2 rounded-full overflow-hidden">
                <div class="bg-brand-500 h-full rounded-full transition-all duration-500 course-progress-bar shadow-dynamic-glow" data-progress="<%= course.percent || 0 %>"></div>
              </div>
            </div>

            <a href="/courses/<%= course.slug %>" class="w-full inline-flex items-center justify-center gap-2 py-2.5 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 group-hover:bg-brand-500 group-hover:text-white rounded-xl font-bold text-xs transition-all shadow-2xs">
              <span>Buka Materi</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
  <% } %>

</div>

<script>
  (function() {
    document.querySelectorAll('.course-progress-bar').forEach(el => {
      el.style.width = (el.getAttribute('data-progress') || 0) + '%';
    });
  })();
</script>
