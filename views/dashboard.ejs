<!-- Halaman Dashboard (Persis Mengadopsi Desain Gambar Quyl / Kyzoo + Hero Greeting Gambar 2) -->

<div class="space-y-6">

  <!-- 0. HERO GREETING BANNER (Persis Referensi Gambar 2) -->
  <div class="bg-gradient-to-b from-[#0b0f19] via-[#0f172a] to-[#0b0f19] text-white rounded-[26px] p-8 sm:p-12 text-center shadow-xl border border-slate-800/80 relative z-20">
    <!-- Ambient Glow Efek Elegan (Tersimpan di layer latar belakang tanpa overflow-hidden pada kartu utama) -->
    <div class="absolute inset-0 rounded-[26px] overflow-hidden pointer-events-none">
      <div class="absolute -top-24 -right-24 w-80 h-80 bg-violet-600/20 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-rose-500/15 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-3xl mx-auto space-y-3">
      <!-- Judul Sapaan Dinamis & Nama Pengguna -->
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight">
        <%= greeting %>, <%= (user && user.name) ? user.name : 'Dimas Pangestu' %>!
      </h1>
      <p class="text-xs sm:text-base text-slate-300/90 font-medium max-w-xl mx-auto">
        Mau belajar atau praktik membuat web app AI apa hari ini?
      </p>

      <!-- Input Pencarian (Fungsional Live Search & Shortcut Ctrl K) -->
      <div class="pt-5 max-w-2xl mx-auto relative">
        <form action="/courses" method="GET" id="heroSearchForm" autocomplete="off">
          <div class="relative flex items-center">
            <div class="absolute inset-y-0 left-0 pl-4 sm:pl-5 flex items-center pointer-events-none text-slate-400">
              <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <input 
              type="text" 
              name="q" 
              id="heroSearchInput"
              placeholder="Cari materi video, modul, atau catatan panduan..." 
              class="w-full pl-11 sm:pl-13 pr-20 sm:pr-24 py-3 sm:py-3.5 bg-slate-900/90 hover:bg-slate-900 border border-slate-700/80 rounded-2xl text-xs sm:text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500 transition-all shadow-inner"
            />
            <div class="absolute inset-y-0 right-0 pr-3 sm:pr-4 flex items-center pointer-events-none">
              <kbd class="px-2 sm:px-2.5 py-1 text-[10px] sm:text-xs font-semibold text-slate-400 bg-slate-800 border border-slate-700 rounded-lg shadow-sm">Ctrl K</kbd>
            </div>
          </div>
        </form>

        <!-- Dropdown Live Search Hasil Cepat -->
        <div id="heroSearchResults" class="hidden absolute top-full left-0 right-0 mt-2 bg-[#0f172a] border border-slate-700/90 rounded-2xl shadow-2xl z-50 overflow-hidden text-left max-h-96 overflow-y-auto divide-y divide-slate-800 ring-1 ring-white/10">
          <!-- Diisi secara dinamis melalui JavaScript -->
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION MY COURSES (Responsive Card untuk HP, Tabel Rapi untuk Desktop) -->
  <div class="bg-white rounded-[22px] border border-slate-100 p-4 sm:p-6 shadow-sm relative z-10">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-base font-bold text-slate-800">My Courses</h3>
      
      <!-- Filter Tabs: Active | Completed (Persis Gambar) -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <button id="tabActiveBtn" onclick="switchCourseTab('active')" class="px-3 sm:px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-violet-100/80 text-violet-700">
          Active
        </button>
        <button id="tabCompletedBtn" onclick="switchCourseTab('completed')" class="px-3 sm:px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-700 transition-all">
          Completed
        </button>
      </div>
    </div>

    <!-- TAMPILAN 1: Tabel Kursus (Khusus Layar Tablet & Desktop - md:block) -->
    <div class="hidden md:block overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 pb-3">
            <th class="py-3 px-2 w-10">#</th>
            <th class="py-3 px-4">Course Name</th>
            <th class="py-3 px-4 w-64">Completed</th>
            <th class="py-3 px-4 text-right">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100/80">
          <% courses.forEach((course, index) => { %>
          <!-- Baris Utama Kursus -->
          <tr class="course-row hover:bg-slate-50/70 transition-colors group cursor-pointer" 
              data-type="<%= course.isFinished ? 'completed' : 'active' %>">
            
            <td class="py-4 px-2 text-xs font-semibold text-slate-400">
              <button type="button" 
                      onclick="toggleDashboardCourseTree(event, '<%= course.id %>')" 
                      class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-violet-100 text-slate-400 hover:text-violet-700 transition-colors" 
                      title="Buka / Tutup Turunan Bab & Materi">
                <svg id="dashboardTreeArrow-<%= course.id %>" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
            </td>

            <td class="py-4 px-4" onclick="window.location.href='/courses/<%= course.slug %>'">
              <div class="flex items-center gap-3.5">
                <div class="w-9 h-9 rounded-xl overflow-hidden shrink-0 shadow-sm border border-slate-100">
                  <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover">
                </div>
                <div>
                  <h4 class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-violet-600 transition-colors line-clamp-1">
                    <%= course.title %>
                  </h4>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-[10px] text-slate-400 font-medium"><%= course.category %></span>
                    <span class="text-[10px] text-violet-600 font-bold bg-violet-50 px-1.5 py-0.5 rounded border border-violet-100">
                      📂 <%= (course.chapters ? course.chapters.length : 0) %> Bab Turunan
                    </span>
                  </div>
                </div>
              </div>
            </td>

            <td class="py-4 px-4" onclick="window.location.href='/courses/<%= course.slug %>'">
              <div class="flex items-center gap-3">
                <div class="flex-1 bg-slate-100 h-2 rounded-full overflow-hidden">
                  <div class="h-full rounded-full transition-all duration-500" 
                       style="width: <%= course.percent %>%; background-color: <%= course.barColor %>;">
                  </div>
                </div>
                <span class="text-xs font-bold text-slate-600 w-9 text-right"><%= course.percent %>%</span>
              </div>
            </td>

            <td class="py-4 px-4 text-right">
              <div class="inline-flex items-center justify-end gap-3 text-xs font-semibold text-slate-400">
                <div class="flex items-center gap-1" title="Lessons">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                  <span><%= course.total_lessons || 15 %></span>
                </div>
                <div class="flex items-center gap-1" title="Assignments">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                  <span>6</span>
                </div>
                <div class="flex items-center gap-1" title="Tests">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <span>3</span>
                </div>
              </div>
            </td>

          </tr>

          <!-- Baris Expandable Turunan Kursus (Pohon Bab & Materi Video) -->
          <tr id="dashboardTreeRow-<%= course.id %>" class="hidden bg-slate-50/80 border-b border-slate-100">
            <td colspan="4" class="p-0">
              <div class="px-6 py-4 pl-12 bg-gradient-to-b from-slate-50/90 to-white border-y border-slate-100/80 space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-bold text-violet-600 uppercase tracking-wider flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-violet-600"></span>
                    Turunan Modul: <span class="text-slate-800 normal-case font-extrabold"><%= course.title %></span>
                  </span>
                  <a href="/courses/<%= course.slug %>" class="text-xs font-bold text-violet-600 hover:text-violet-800 hover:underline flex items-center gap-1">
                    <span>Lihat Halaman Kursus Lengkap</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                  </a>
                </div>

                <!-- Pohon Turunan Bab & Materi -->
                <div class="space-y-3 pl-3 border-l-2 border-violet-200 ml-1">
                  <% if (course.chapters && course.chapters.length > 0) { %>
                    <% course.chapters.forEach((ch, chIdx) => { %>
                      <div class="bg-white rounded-xl p-3.5 border border-slate-100 shadow-sm">
                        <!-- Induk Turunan Tingkat 1: Bab / Chapter -->
                        <div class="flex items-center justify-between text-xs font-bold text-slate-800 pb-2 border-b border-slate-100">
                          <span class="flex items-center gap-2">
                            <span class="w-5 h-5 rounded-md bg-violet-100 text-violet-700 text-[10px] flex items-center justify-center font-bold">
                              <%= chIdx + 1 %>
                            </span>
                            <span><%= ch.title %></span>
                          </span>
                          <span class="text-[10px] text-slate-400 font-semibold"><%= ch.lessons ? ch.lessons.length : 0 %> Video Pembelajaran</span>
                        </div>

                        <!-- Turunan Tingkat 2: Materi / Lesson Video -->
                        <div class="mt-2 space-y-1 pl-4">
                          <% if (ch.lessons && ch.lessons.length > 0) { %>
                            <% ch.lessons.forEach(l => { %>
                              <a href="/learn/<%= course.slug %>/<%= l.id %>" class="flex items-center justify-between py-1.5 px-2.5 rounded-lg hover:bg-violet-50 text-xs transition-colors group">
                                <div class="flex items-center gap-2 min-w-0">
                                  <span class="w-4 h-4 rounded-full flex items-center justify-center text-[10px] shrink-0 <%= l.is_completed ? 'bg-emerald-500 text-white font-bold' : 'border border-slate-300 text-transparent' %>">
                                    ✓
                                  </span>
                                  <span class="text-slate-700 group-hover:text-violet-700 font-medium truncate"><%= l.title %></span>
                                </div>
                                <div class="flex items-center gap-3 text-[10px] text-slate-400 shrink-0 ml-2">
                                  <span><%= l.duration_minutes %> menit</span>
                                  <span class="text-violet-600 font-bold group-hover:underline">Putar Video ▶</span>
                                </div>
                              </a>
                            <% }) %>
                          <% } else { %>
                            <span class="text-[10px] text-slate-400 italic">Belum ada video materi di bab ini.</span>
                          <% } %>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <span class="text-xs text-slate-400 italic">Belum ada bab turunan untuk kursus ini.</span>
                  <% } %>
                </div>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- TAMPILAN 2: Kartu Kursus Responsif (Khusus Layar HP / Mobile - block md:hidden) -->
    <div class="block md:hidden space-y-3">
      <% courses.forEach((course, index) => { %>
      <div class="course-card-mobile p-4 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:border-violet-200 transition-all shadow-sm"
           data-type="<%= course.isFinished ? 'completed' : 'active' %>">
        
        <div class="flex items-center gap-3 mb-3" onclick="window.location.href='/courses/<%= course.slug %>'">
          <div class="w-11 h-11 rounded-xl overflow-hidden shrink-0 shadow-sm border border-slate-100">
            <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover">
          </div>
          <div class="min-w-0 flex-1">
            <div class="text-[10px] font-bold text-violet-600 uppercase tracking-wider"><%= course.code %></div>
            <h4 class="text-sm font-bold text-slate-900 truncate"><%= course.title %></h4>
            <span class="text-[10px] text-slate-400 font-medium"><%= course.category %></span>
          </div>
        </div>

        <!-- Progress Bar HP -->
        <div class="space-y-1.5 pt-2 border-t border-slate-100" onclick="window.location.href='/courses/<%= course.slug %>'">
          <div class="flex justify-between text-xs font-semibold text-slate-500">
            <span>Capaian Belajar</span>
            <span class="font-bold text-slate-800"><%= course.percent %>%</span>
          </div>
          <div class="w-full bg-slate-200/60 h-2 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all duration-500" 
                 style="width: <%= course.percent %>%; background-color: <%= course.barColor %>;">
            </div>
          </div>
        </div>

        <!-- Tombol Buka Turunan Modul Bab di HP -->
        <div class="mt-3.5 pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
          <button type="button" 
                  onclick="toggleMobileCourseTree(event, '<%= course.id %>')" 
                  class="flex-1 py-2 px-3 rounded-xl bg-violet-50 hover:bg-violet-100 text-violet-700 text-xs font-bold flex items-center justify-between transition-colors">
            <span>Lihat <%= (course.chapters ? course.chapters.length : 0) %> Bab Turunan</span>
            <svg id="mobileTreeChevron-<%= course.id %>" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <a href="/courses/<%= course.slug %>" class="px-3 py-2 rounded-xl bg-slate-900 text-white text-xs font-bold">
            Buka →
          </a>
        </div>

        <!-- Wadah Turunan Modul HP -->
        <div id="mobileCourseTree-<%= course.id %>" class="hidden mt-3 pt-3 border-t border-slate-200/60 space-y-2">
          <% if (course.chapters && course.chapters.length > 0) { %>
            <% course.chapters.forEach((ch, chIdx) => { %>
              <div class="p-2.5 rounded-xl bg-white border border-slate-100 space-y-1.5">
                <div class="text-xs font-bold text-slate-800 flex items-center justify-between">
                  <span><%= chIdx + 1 %>. <%= ch.title %></span>
                  <span class="text-[10px] text-slate-400 font-semibold"><%= ch.lessons ? ch.lessons.length : 0 %> video</span>
                </div>
                <div class="space-y-1 pl-2 border-l border-slate-100">
                  <% if (ch.lessons && ch.lessons.length > 0) { %>
                    <% ch.lessons.forEach(l => { %>
                      <a href="/learn/<%= course.slug %>/<%= l.id %>" class="flex items-center justify-between py-1 text-[11px] text-slate-600 hover:text-violet-600">
                        <span class="truncate">↳ <%= l.title %></span>
                        <span class="text-[10px] text-violet-600 font-bold shrink-0 ml-1">Putar</span>
                      </a>
                    <% }) %>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-[11px] text-slate-400 italic">Belum ada bab turunan.</div>
          <% } %>
        </div>

      </div>
      <% }) %>
    </div>

  </div>

</div>

<script>
  // Toggle Pohon Turunan Kursus di Desktop Table
  function toggleDashboardCourseTree(e, courseId) {
    if (e) e.stopPropagation();
    const row = document.getElementById('dashboardTreeRow-' + courseId);
    const arrow = document.getElementById('dashboardTreeArrow-' + courseId);
    if (!row) return;

    if (row.classList.contains('hidden')) {
      row.classList.remove('hidden');
      if (arrow) arrow.classList.add('rotate-90', 'text-violet-600');
    } else {
      row.classList.add('hidden');
      if (arrow) arrow.classList.remove('rotate-90', 'text-violet-600');
    }
  }

  // Toggle Pohon Turunan Kursus di Mobile Card
  function toggleMobileCourseTree(e, courseId) {
    if (e) e.stopPropagation();
    const container = document.getElementById('mobileCourseTree-' + courseId);
    const chevron = document.getElementById('mobileTreeChevron-' + courseId);
    if (!container) return;

    if (container.classList.contains('hidden')) {
      container.classList.remove('hidden');
      if (chevron) chevron.classList.add('rotate-180');
    } else {
      container.classList.add('hidden');
      if (chevron) chevron.classList.remove('rotate-180');
    }
  }

  function switchCourseTab(type) {
    const activeBtn = document.getElementById('tabActiveBtn');
    const compBtn = document.getElementById('tabCompletedBtn');
    const items = document.querySelectorAll('.course-row, .course-card-mobile');

    if (type === 'active') {
      activeBtn.className = "px-3 sm:px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-violet-100/80 text-violet-700";
      compBtn.className = "px-3 sm:px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-700 transition-all";
      items.forEach(el => {
        if (el.getAttribute('data-type') === 'active') {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    } else {
      compBtn.className = "px-3 sm:px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-violet-100/80 text-violet-700";
      activeBtn.className = "px-3 sm:px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-700 transition-all";
      items.forEach(el => {
        if (el.getAttribute('data-type') === 'completed') {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    }
  }

  // Live Search Input Handler
  const heroSearchInput = document.getElementById('heroSearchInput');
  const heroSearchResults = document.getElementById('heroSearchResults');
  let searchTimer = null;

  if (heroSearchInput && heroSearchResults) {
    heroSearchInput.addEventListener('input', (e) => {
      const query = e.target.value.trim();
      clearTimeout(searchTimer);

      // 1. Live Filter Kursus di Halaman Dashboard (Tabel & Kartu Mobile)
      const filterTerm = query.toLowerCase();
      const courseItems = document.querySelectorAll('.course-row, .course-card-mobile');
      courseItems.forEach(item => {
        const text = item.textContent.toLowerCase();
        if (!filterTerm || text.includes(filterTerm)) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });

      // 2. Jika query kosong, sembunyikan dropdown
      if (!query) {
        heroSearchResults.classList.add('hidden');
        heroSearchResults.innerHTML = '';
        return;
      }

      // 3. Debounce AJAX Live Search ke /api/search
      searchTimer = setTimeout(async () => {
        try {
          const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
          const data = await res.json();
          renderSearchResults(data, query);
        } catch (err) {
          console.error('Search error:', err);
        }
      }, 200);
    });

    // Sembunyikan dropdown jika klik di luar
    document.addEventListener('click', (e) => {
      if (!heroSearchInput.contains(e.target) && !heroSearchResults.contains(e.target)) {
        heroSearchResults.classList.add('hidden');
      }
    });

    // Tombol Escape menutup dropdown
    heroSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        heroSearchResults.classList.add('hidden');
      }
    });
  }

  function renderSearchResults(data, query) {
    const { courses, lessons } = data;
    if (courses.length === 0 && lessons.length === 0) {
      heroSearchResults.innerHTML = `
        <div class="p-4 text-xs text-slate-400 text-center">
          Tidak ditemukan modul atau video yang cocok dengan "<span class="text-white font-bold">${escapeHtml(query)}</span>"
        </div>
      `;
      heroSearchResults.classList.remove('hidden');
      return;
    }

    let html = '';

    // Modul Kursus
    if (courses.length > 0) {
      html += `
        <div class="p-3 bg-slate-950/60 text-[11px] font-bold uppercase tracking-wider text-violet-400">
          📚 Modul Kursus
        </div>
        <div class="p-1 space-y-0.5">
      `;
      courses.forEach(c => {
        html += `
          <a href="/courses/${c.slug}" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-800 transition-colors group">
            <img src="${c.thumbnail}" class="w-8 h-8 rounded-lg object-cover shrink-0 border border-slate-700">
            <div class="min-w-0 flex-1">
              <h5 class="text-xs font-bold text-white group-hover:text-violet-400 truncate">${escapeHtml(c.title)}</h5>
              <span class="text-[10px] text-slate-400">${escapeHtml(c.category)}</span>
            </div>
          </a>
        `;
      });
      html += `</div>`;
    }

    // Video Tutorial & Materi
    if (lessons.length > 0) {
      html += `
        <div class="p-3 bg-slate-950/60 text-[11px] font-bold uppercase tracking-wider text-emerald-400">
          🎥 Video Tutorial
        </div>
        <div class="p-1 space-y-0.5">
      `;
      lessons.forEach(l => {
        html += `
          <a href="/learn/${l.course_slug}/${l.id}" class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-800 transition-colors group">
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 text-xs font-bold">▶</span>
              <div class="min-w-0">
                <h5 class="text-xs font-bold text-white group-hover:text-emerald-400 truncate">${escapeHtml(l.title)}</h5>
                <span class="text-[10px] text-slate-400">${escapeHtml(l.course_title)}</span>
              </div>
            </div>
            <span class="text-[10px] text-slate-400 shrink-0 ml-2">${l.duration_minutes}m</span>
          </a>
        `;
      });
      html += `</div>`;
    }

    heroSearchResults.innerHTML = html;
    heroSearchResults.classList.remove('hidden');
  }

  function escapeHtml(text) {
    if (!text) return '';
    return text.replace(/[&<>"']/g, m => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    })[m]);
  }
</script>
