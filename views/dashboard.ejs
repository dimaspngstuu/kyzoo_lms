<!-- Halaman Dashboard (Persis Mengadopsi Desain Gambar Quyl / Kyzoo + Hero Greeting Gambar 2) -->

<div class="space-y-6">

  <!-- 0. HERO GREETING BANNER (Persis Referensi Gambar 2) -->
  <div class="bg-gradient-to-b from-[#0b0f19] via-[#0f172a] to-[#0b0f19] text-white rounded-[26px] p-8 sm:p-12 text-center shadow-xl border border-slate-800/80 relative overflow-hidden">
    <!-- Ambient Glow Efek Elegan -->
    <div class="absolute -top-24 -right-24 w-80 h-80 bg-violet-600/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-rose-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl mx-auto space-y-3">
      <!-- Judul Sapaan Dinamis & Nama Pengguna -->
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight">
        <%= greeting %>, <%= (user && user.name) ? user.name : 'Dimas Pangestu' %>!
      </h1>
      <p class="text-xs sm:text-base text-slate-300/90 font-medium max-w-xl mx-auto">
        Mau belajar atau praktik membuat web app AI apa hari ini?
      </p>

      <!-- Input Pencarian Sesuai Gambar 2 (dengan Shortcut Ctrl K) -->
      <form action="/courses" method="GET" class="pt-5 max-w-2xl mx-auto">
        <div class="relative flex items-center">
          <div class="absolute inset-y-0 left-0 pl-4 sm:pl-5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input 
            type="text" 
            name="q" 
            id="heroSearchInput"
            placeholder="Cari materi video, modul, catatan, atau Zettbos Library..." 
            class="w-full pl-11 sm:pl-13 pr-20 sm:pr-24 py-3 sm:py-3.5 bg-slate-900/90 hover:bg-slate-900 border border-slate-700/80 rounded-2xl text-xs sm:text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500 transition-all shadow-inner"
          />
          <div class="absolute inset-y-0 right-0 pr-3 sm:pr-4 flex items-center pointer-events-none">
            <kbd class="px-2 sm:px-2.5 py-1 text-[10px] sm:text-xs font-semibold text-slate-400 bg-slate-800 border border-slate-700 rounded-lg shadow-sm">Ctrl K</kbd>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- 1. RESUME BANNER (Kartu Lanjut Belajar di Bagian Atas) -->
  <% if (resumeCourse) { %>
  <div class="bg-white rounded-[22px] border border-slate-100 p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-4 w-full sm:w-auto">
      <!-- Gradient Artwork Thumbnail (Persis Ikon Gambar) -->
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-violet-600 via-rose-500 to-amber-400 flex items-center justify-center shrink-0 shadow-sm overflow-hidden p-0.5">
        <div class="w-full h-full bg-white/20 rounded-[14px] flex items-center justify-center backdrop-blur-sm">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>

      <!-- Info Kursus Lanjutan -->
      <div>
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-bold uppercase tracking-wider text-violet-600 bg-violet-50 px-2.5 py-0.5 rounded-full">Lanjutkan Belajar</span>
          <span class="text-xs text-slate-400 font-medium">Progress <%= resumeCourse.percent || 0 %>%</span>
        </div>
        <h2 class="text-base sm:text-lg font-bold text-slate-900 mt-0.5 line-clamp-1">
          <%= resumeCourse.title %>
        </h2>
        <div class="w-32 sm:w-48 bg-slate-100 h-1.5 rounded-full mt-2 overflow-hidden">
          <div class="bg-[#6c5dd3] h-full rounded-full transition-all duration-500" style="width: <%= resumeCourse.percent || 0 %>%"></div>
        </div>
      </div>
    </div>

    <!-- Metrik Mini & Tombol Resume -->
    <div class="flex items-center justify-between sm:justify-end gap-6 w-full sm:w-auto pt-3 sm:pt-0 border-t sm:border-t-0 border-slate-100">
      <!-- Indikator 15, 6, 3 persis di gambar -->
      <div class="flex items-center gap-4 text-xs font-semibold text-slate-500">
        <div class="flex items-center gap-1.5" title="Lessons">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
          <span><%= resumeCourse.total_lessons || 15 %></span>
        </div>
        <div class="flex items-center gap-1.5" title="Assignments">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <span>6</span>
        </div>
        <div class="flex items-center gap-1.5" title="Tests">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>3</span>
        </div>
      </div>

      <!-- Tombol Resume (Persis Gambar) -->
      <a href="/learn/<%= resumeCourse.slug %>" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-violet-200 text-violet-700 bg-violet-50/60 hover:bg-[#6c5dd3] hover:text-white hover:border-[#6c5dd3] font-bold text-xs sm:text-sm transition-all shadow-sm">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <span>Resume</span>
      </a>
    </div>
  </div>
  <% } %>

  <!-- 2. STATUS METRIC CARDS (3 Kartu Pastel Persis di Gambar Quyl) -->
  <div>
    <h3 class="text-sm font-bold text-slate-800 mb-3.5">Status</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

      <!-- KARTU 1 (PEACH / WARM ORANGE) -->
      <div class="bg-[#FFF4EE] border border-[#FFE2D4] rounded-[22px] p-5 relative overflow-hidden flex items-center justify-between">
        <div>
          <!-- Ikon Bulat Peach -->
          <div class="w-10 h-10 rounded-xl bg-[#FF8A65]/20 flex items-center justify-center text-[#D84315] mb-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <div class="text-2xl font-black text-slate-900 leading-tight">
            <%= String(stats.completedLessons).padStart(2, '0') %> <span class="text-base font-bold text-slate-800">Lessons</span>
          </div>
          <div class="text-xs text-slate-500 font-medium mt-0.5">
            of <%= stats.totalLessons %> completed
          </div>
        </div>

        <!-- Lingkaran Persentase 59% / Dynamic -->
        <div class="relative w-16 h-16 flex items-center justify-center shrink-0">
          <svg class="w-16 h-16 transform -rotate-90">
            <circle cx="32" cy="32" r="26" stroke="#FFE2D4" stroke-width="5" fill="transparent" />
            <circle cx="32" cy="32" r="26" stroke="#FF8A65" stroke-width="5" fill="transparent"
              stroke-dasharray="163.36"
              stroke-dashoffset="<%= 163.36 - (163.36 * (stats.overallPercentage || 59)) / 100 %>"
              stroke-linecap="round" />
          </svg>
          <span class="absolute text-[11px] font-bold text-[#D84315]"><%= stats.overallPercentage || 59 %>%</span>
        </div>
      </div>

      <!-- KARTU 2 (SOFT PINK) -->
      <div class="bg-[#FFF0F4] border border-[#FFDCE5] rounded-[22px] p-5 relative overflow-hidden flex items-center justify-between">
        <div>
          <!-- Ikon Bulat Pink -->
          <div class="w-10 h-10 rounded-xl bg-[#FF5A79]/20 flex items-center justify-center text-[#C2185B] mb-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div class="text-2xl font-black text-slate-900 leading-tight">
            <%= String(stats.totalChapters).padStart(2, '0') %> <span class="text-base font-bold text-slate-800">Assignments</span>
          </div>
          <div class="text-xs text-slate-500 font-medium mt-0.5">
            of <%= stats.totalChapters * 3 %> completed
          </div>
        </div>

        <!-- Lingkaran Persentase Pink -->
        <div class="relative w-16 h-16 flex items-center justify-center shrink-0">
          <svg class="w-16 h-16 transform -rotate-90">
            <circle cx="32" cy="32" r="26" stroke="#FFDCE5" stroke-width="5" fill="transparent" />
            <circle cx="32" cy="32" r="26" stroke="#FF5A79" stroke-width="5" fill="transparent"
              stroke-dasharray="163.36"
              stroke-dashoffset="<%= 163.36 - (163.36 * 59) / 100 %>"
              stroke-linecap="round" />
          </svg>
          <span class="absolute text-[11px] font-bold text-[#C2185B]">59%</span>
        </div>
      </div>

      <!-- KARTU 3 (SOFT MINT / GREEN) -->
      <div class="bg-[#EEFAF3] border border-[#D4F3E3] rounded-[22px] p-5 relative overflow-hidden flex items-center justify-between">
        <div>
          <!-- Ikon Bulat Mint -->
          <div class="w-10 h-10 rounded-xl bg-[#4CAF50]/20 flex items-center justify-center text-[#2E7D32] mb-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="text-2xl font-black text-slate-900 leading-tight">
            <%= String(stats.totalCourses).padStart(2, '0') %> <span class="text-base font-bold text-slate-800">Tests</span>
          </div>
          <div class="text-xs text-slate-500 font-medium mt-0.5">
            of <%= stats.totalCourses * 5 %> completed
          </div>
        </div>

        <!-- Lingkaran Persentase Mint -->
        <div class="relative w-16 h-16 flex items-center justify-center shrink-0">
          <svg class="w-16 h-16 transform -rotate-90">
            <circle cx="32" cy="32" r="26" stroke="#D4F3E3" stroke-width="5" fill="transparent" />
            <circle cx="32" cy="32" r="26" stroke="#4CAF50" stroke-width="5" fill="transparent"
              stroke-dasharray="163.36"
              stroke-dashoffset="<%= 163.36 - (163.36 * 59) / 100 %>"
              stroke-linecap="round" />
          </svg>
          <span class="absolute text-[11px] font-bold text-[#2E7D32]">59%</span>
        </div>
      </div>

    </div>
  </div>

  <!-- 3. SECTION MY COURSES (Responsive Card untuk HP, Tabel Rapi untuk Desktop) -->
  <div class="bg-white rounded-[22px] border border-slate-100 p-4 sm:p-6 shadow-sm">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-base font-bold text-slate-800">My Courses</h3>
      
      <!-- Filter Tabs: Active | Completed (Persis Gambar) -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <button id="tabActiveBtn" onclick="switchCourseTab('active')" class="px-3 sm:px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-violet-100/80 text-violet-700">
          Active
        </button>
        <button id="tabCompletedBtn" onclick="switchCourseTab('completed')" class="px-3 sm:px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-700 transition-all">
          Completed
        </button>
      </div>
    </div>

    <!-- TAMPILAN 1: Tabel Kursus (Khusus Layar Tablet & Desktop - md:block) -->
    <div class="hidden md:block overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 pb-3">
            <th class="py-3 px-2 w-10">#</th>
            <th class="py-3 px-4">Course Name</th>
            <th class="py-3 px-4 w-64">Completed</th>
            <th class="py-3 px-4 text-right">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100/80">
          <% courses.forEach((course, index) => { %>
          <tr class="course-row hover:bg-slate-50/70 transition-colors group cursor-pointer" 
              data-type="<%= course.isFinished ? 'completed' : 'active' %>"
              onclick="window.location.href='/courses/<%= course.slug %>'">
            
            <td class="py-4 px-2 text-xs font-semibold text-slate-400">
              <%= index + 1 %>
            </td>

            <td class="py-4 px-4">
              <div class="flex items-center gap-3.5">
                <div class="w-9 h-9 rounded-xl overflow-hidden shrink-0 shadow-sm border border-slate-100">
                  <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover">
                </div>
                <div>
                  <h4 class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-violet-600 transition-colors line-clamp-1">
                    <%= course.title %>
                  </h4>
                  <span class="text-[10px] text-slate-400 font-medium"><%= course.category %></span>
                </div>
              </div>
            </td>

            <td class="py-4 px-4">
              <div class="flex items-center gap-3">
                <div class="flex-1 bg-slate-100 h-2 rounded-full overflow-hidden">
                  <div class="h-full rounded-full transition-all duration-500" 
                       style="width: <%= course.percent %>%; background-color: <%= course.barColor %>;">
                  </div>
                </div>
                <span class="text-xs font-bold text-slate-600 w-9 text-right"><%= course.percent %>%</span>
              </div>
            </td>

            <td class="py-4 px-4 text-right">
              <div class="inline-flex items-center justify-end gap-3 text-xs font-semibold text-slate-400">
                <div class="flex items-center gap-1" title="Lessons">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                  <span><%= course.total_lessons || 15 %></span>
                </div>
                <div class="flex items-center gap-1" title="Assignments">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                  <span>6</span>
                </div>
                <div class="flex items-center gap-1" title="Tests">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <span>3</span>
                </div>
              </div>
            </td>

          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- TAMPILAN 2: Kartu Kursus Responsif (Khusus Layar HP / Mobile - block md:hidden) -->
    <div class="block md:hidden space-y-3">
      <% courses.forEach((course, index) => { %>
      <div class="course-card-mobile p-4 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:border-violet-200 transition-all cursor-pointer shadow-sm"
           data-type="<%= course.isFinished ? 'completed' : 'active' %>"
           onclick="window.location.href='/courses/<%= course.slug %>'">
        
        <div class="flex items-center gap-3 mb-3">
          <div class="w-11 h-11 rounded-xl overflow-hidden shrink-0 shadow-sm border border-slate-100">
            <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover">
          </div>
          <div class="min-w-0 flex-1">
            <div class="text-[10px] font-bold text-violet-600 uppercase tracking-wider"><%= course.code %></div>
            <h4 class="text-sm font-bold text-slate-900 truncate"><%= course.title %></h4>
            <span class="text-[10px] text-slate-400 font-medium"><%= course.category %></span>
          </div>
        </div>

        <!-- Progress Bar HP -->
        <div class="space-y-1.5 pt-2 border-t border-slate-100">
          <div class="flex justify-between text-xs font-semibold text-slate-500">
            <span>Capaian Belajar</span>
            <span class="font-bold text-slate-800"><%= course.percent %>%</span>
          </div>
          <div class="w-full bg-slate-200/60 h-2 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all duration-500" 
                 style="width: <%= course.percent %>%; background-color: <%= course.barColor %>;">
            </div>
          </div>
        </div>

        <!-- Tombol Lanjut Belajar Full-Width Ramah Sentuhan Jempol -->
        <div class="mt-3.5 flex items-center justify-between text-xs font-semibold text-slate-500">
          <span class="text-[11px] text-slate-400"><%= course.total_lessons %> Video Tutorial</span>
          <span class="text-xs font-bold text-violet-600 flex items-center gap-1">
            Buka Modul →
          </span>
        </div>

      </div>
      <% }) %>
    </div>

  </div>

</div>

<script>
  function switchCourseTab(type) {
    const activeBtn = document.getElementById('tabActiveBtn');
    const compBtn = document.getElementById('tabCompletedBtn');
    const items = document.querySelectorAll('.course-row, .course-card-mobile');

    if (type === 'active') {
      activeBtn.className = "px-3 sm:px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-violet-100/80 text-violet-700";
      compBtn.className = "px-3 sm:px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-700 transition-all";
      items.forEach(el => {
        if (el.getAttribute('data-type') === 'active') {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    } else {
      compBtn.className = "px-3 sm:px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-violet-100/80 text-violet-700";
      activeBtn.className = "px-3 sm:px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-700 transition-all";
      items.forEach(el => {
        if (el.getAttribute('data-type') === 'completed') {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    }
  }
</script>
