<!-- Halaman Dashboard (Konsep 1: Modern Clean Light & Dark Mode Interaktif) -->

<div class="space-y-6">

  <!-- 1. HERO HEADER (Clean Editorial SaaS ala Stripe / Notion) -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200/80 dark:border-slate-800 shadow-2xs relative z-20 transition-all duration-300">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="space-y-1.5">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-[11px] font-semibold text-slate-600 dark:text-slate-300">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>Portal Pembelajaran Kyzoo</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          <%= greeting %>, <%= (user && user.name) ? user.name : 'Member' %>
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal">
          Lanjutkan materi kursus dan pantau pencapaian belajar Anda secara terstruktur.
        </p>
      </div>

      <!-- Bilah Pencarian Cepat (Command Palette Input) -->
      <div class="w-full md:w-96 relative">
        <form action="/courses" method="GET" id="heroSearchForm" autocomplete="off">
          <div class="relative flex items-center">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <input 
              type="text" 
              name="q" 
              id="heroSearchInput"
              placeholder="Cari materi tutorial atau modul..." 
              class="w-full pl-10 pr-20 py-2.5 bg-slate-50 dark:bg-slate-800/80 hover:bg-white dark:hover:bg-slate-800 focus:bg-white dark:focus:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs sm:text-sm text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all"
            />
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
              <kbd class="px-2 py-0.5 text-[10px] font-semibold text-slate-500 dark:text-slate-400 bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-md shadow-2xs">Ctrl K</kbd>
            </div>
          </div>
        </form>

        <!-- Dropdown Live Search Hasil Cepat -->
        <div id="heroSearchResults" class="hidden absolute top-full left-0 right-0 mt-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl z-50 overflow-hidden text-left max-h-96 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-700">
          <!-- Diisi secara dinamis melalui JavaScript -->
        </div>
      </div>
    </div>
  </div>

  <!-- 2. METRIC STRIP (Clean Neutral SaaS ala Stripe) -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <!-- Card 1: Total Modul Aktif -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-2xs hover:border-slate-300 dark:hover:border-slate-700 transition-all group">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Modul Kursus</span>
        <div class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
        </div>
      </div>
      <div class="text-2xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        <%= stats.totalCourses %>
      </div>
      <div class="flex items-center gap-1.5 text-[11px] text-slate-400 mt-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>Kelas aktif tersedia</span>
      </div>
    </div>

    <!-- Card 2: Materi Selesai -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-2xs hover:border-slate-300 dark:hover:border-slate-700 transition-all group">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Materi Selesai</span>
        <div class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
      </div>
      <div class="text-2xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        <%= stats.completedLessons %> <span class="text-xs font-medium text-slate-400">/ <%= stats.totalLessons %></span>
      </div>
      <div class="flex items-center gap-1.5 text-[11px] text-slate-400 mt-1">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
        <span><%= stats.totalLessons - stats.completedLessons %> materi tersisa</span>
      </div>
    </div>

    <!-- Card 3: Capaian Belajar -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-2xs hover:border-slate-300 dark:hover:border-slate-700 transition-all group">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Capaian Belajar</span>
        <span class="text-xs font-extrabold text-slate-900 dark:text-white"><%= stats.overallPercentage %>%</span>
      </div>
      <div class="text-2xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        <%= stats.overallPercentage %>%
      </div>
      <div class="w-full bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden mt-3">
        <div class="bg-slate-900 dark:bg-white h-full rounded-full transition-all duration-700 dashboard-bar" data-progress="<%= stats.overallPercentage || 0 %>"></div>
      </div>
    </div>
  </div>

  <!-- 3. SECTION MY COURSES (Bento Card Grid & Opsi Switch Tabel) -->
  <div class="bg-white dark:bg-slate-900 rounded-[24px] border border-slate-200/80 dark:border-slate-800 p-5 sm:p-7 shadow-xs relative z-10 transition-colors duration-300">
    <!-- Header Section My Courses -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
      <div>
        <h3 class="text-lg font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
          <span>My Courses</span>
          <span class="px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-bold"><%= courses.length %></span>
        </h3>
        <p class="text-xs text-slate-400 font-medium mt-0.5">Daftar modul pembelajaran dan materi yang Anda ikuti</p>
      </div>
      
      <div class="flex items-center justify-between sm:justify-end gap-3">
        <!-- Switch View: Grid / Tabel -->
        <div class="inline-flex p-1 bg-slate-100 dark:bg-slate-800 rounded-xl border border-slate-200/60 dark:border-slate-700 text-xs font-bold">
          <button id="viewGridBtn" onclick="switchCourseView('grid')" class="px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1.5 bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs" title="Tampilan Kartu Bento">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="3" width="7" height="7" rx="1.5" stroke-width="2"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1.5" stroke-width="2"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1.5" stroke-width="2"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1.5" stroke-width="2"></rect>
            </svg>
            <span class="hidden sm:inline">Grid</span>
          </button>
          <button id="viewTableBtn" onclick="switchCourseView('table')" class="px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white" title="Tampilan Tabel Rapi">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <span class="hidden sm:inline">Tabel</span>
          </button>
        </div>

        <!-- Filter Tabs: Active | Completed -->
        <div class="inline-flex p-1 bg-slate-100 dark:bg-slate-800 rounded-xl border border-slate-200/60 dark:border-slate-700 text-xs font-bold">
          <button id="tabActiveBtn" onclick="switchCourseTab('active')" class="px-3 py-1.5 rounded-lg transition-all bg-white dark:bg-slate-700 text-brand-500 dark:text-brand-400 shadow-xs">
            Active
          </button>
          <button id="tabCompletedBtn" onclick="switchCourseTab('completed')" class="px-3 py-1.5 rounded-lg transition-all text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white">
            Completed
          </button>
        </div>
      </div>
    </div>

    <!-- TAMPILAN 1: BENTO CARD GRID (Default & Paling Rapi, Mengisi Ruang Layar) -->
    <div id="courseGridView" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% courses.forEach((course, index) => { %>
      <div class="course-bento-card bg-slate-50/50 dark:bg-slate-800/40 hover:bg-white dark:hover:bg-slate-800/90 rounded-2xl border border-slate-200/80 dark:border-slate-750 hover:border-brand-300 dark:hover:border-brand-500 p-5 transition-all duration-300 shadow-2xs hover:shadow-xl hover:-translate-y-1 flex flex-col justify-between group"
           data-type="<%= course.isFinished ? 'completed' : 'active' %>">
        
        <div>
          <!-- Thumbnail & Status Meta -->
          <div class="relative w-full aspect-video rounded-xl overflow-hidden mb-3.5 bg-slate-100 dark:bg-slate-800 border border-slate-200/70 dark:border-slate-700 shadow-2xs">
            <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
          </div>

          <!-- Metadata Pill Bar (Clean & Teratur) -->
          <div class="flex items-center gap-2 mb-2.5">
            <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono text-[10px] font-bold">
              <%= course.code %>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700 text-slate-600 dark:text-slate-300 text-[10px] font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
              <%= course.category %>
            </span>
          </div>

          <!-- Info Kursus -->
          <div class="space-y-1.5 mb-4">
            <h4 class="text-base font-extrabold text-slate-900 dark:text-white group-hover:text-brand-500 transition-colors line-clamp-2 leading-snug">
              <a href="/courses/<%= course.slug %>"><%= course.title %></a>
            </h4>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-normal line-clamp-2 leading-relaxed">
              <%= course.description || 'Pelajari materi terstruktur dan praktik langsung langkah demi langkah.' %>
            </p>
          </div>

          <!-- Indikator Metrik Bab & Materi -->
          <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400 font-medium py-2 border-y border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
              <span><%= course.chapters ? course.chapters.length : 0 %> Bab</span>
            </div>
            <span>•</span>
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              <span><%= course.total_lessons || 0 %> Materi</span>
            </div>
          </div>

          <!-- Progress Bar Modul -->
          <div class="mt-3.5 space-y-1.5">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-600 dark:text-slate-400">
              <span>Progres Belajar</span>
              <span class="font-extrabold text-slate-900 dark:text-white"><%= course.percent %>%</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
              <div class="h-full rounded-full transition-all duration-500 dashboard-bar" data-progress="<%= course.percent || 0 %>" data-color="<%= course.barColor || '#6c5dd3' %>"></div>
            </div>
            <div class="text-[11px] text-slate-400 font-normal">
              <%= course.completed_lessons || 0 %> dari <%= course.total_lessons || 0 %> materi selesai
            </div>
          </div>
        </div>

        <!-- Tombol Aksi & Accordion Turunan -->
        <div class="mt-5 pt-3.5 border-t border-slate-100 dark:border-slate-800 space-y-2">
          <!-- Accordion Toggle Bab Turunan -->
          <button type="button" 
                  onclick="toggleBentoChapterDrawer(event, '<%= course.id %>')" 
                  class="w-full py-2 px-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/60 dark:border-slate-700/60 text-slate-600 dark:text-slate-300 text-xs font-semibold flex items-center justify-between transition-colors">
            <span class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
              <span>Silabus Bab & Materi</span>
            </span>
            <svg id="bentoDrawerIcon-<%= course.id %>" class="w-4 h-4 transition-transform duration-200 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <!-- Drawer Turunan Bab Bento (Expandable) -->
          <div id="bentoChapterDrawer-<%= course.id %>" class="hidden space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800 max-h-60 overflow-y-auto">
            <% if (course.chapters && course.chapters.length > 0) { %>
              <% course.chapters.forEach((ch, chIdx) => { %>
                <div class="p-2.5 rounded-xl bg-white dark:bg-slate-850 border border-slate-100 dark:border-slate-700/80 space-y-1.5 shadow-2xs">
                  <div class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center justify-between">
                    <span class="truncate">Bab <%= chIdx + 1 %>: <%= ch.title %></span>
                    <span class="text-[10px] text-slate-400 font-semibold shrink-0 ml-1"><%= ch.lessons ? ch.lessons.length : 0 %> materi</span>
                  </div>
                  <div class="space-y-1 pl-2 border-l border-brand-200 dark:border-brand-800">
                    <% if (ch.lessons && ch.lessons.length > 0) { %>
                      <% ch.lessons.forEach(l => { %>
                        <a href="/learn/<%= course.slug %>/<%= l.id %>" class="flex items-center justify-between py-1 text-[11px] text-slate-600 dark:text-slate-300 hover:text-brand-500 group/l">
                          <span class="truncate flex items-center gap-1.5">
                            <span class="w-3.5 h-3.5 rounded-full flex items-center justify-center text-[9px] <%= l.is_completed ? 'bg-emerald-500 text-white font-bold' : 'border border-slate-300 dark:border-slate-600 text-transparent' %>">✓</span>
                            <span><%= l.title %></span>
                          </span>
                          <span class="text-[10px] text-slate-500 hover:text-slate-900 font-semibold shrink-0 ml-1">Buka →</span>
                        </a>
                      <% }) %>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="text-[11px] text-slate-400 italic p-2">Belum ada bab turunan.</div>
            <% } %>
          </div>

          <!-- Tombol Lanjut Belajar -->
          <a href="/courses/<%= course.slug %>" class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100 text-white text-xs font-semibold text-center flex items-center justify-center gap-2 transition-all shadow-2xs">
            <span>Lanjutkan Belajar</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>

      </div>
      <% }) %>
    </div>

    <!-- TAMPILAN 2: TABEL KURSUS (Switchable untuk Pengguna yang Menyukai List View) -->
    <div id="courseTableView" class="hidden overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 dark:border-slate-800 pb-3">
            <th class="py-3 px-2 w-10">#</th>
            <th class="py-3 px-4">Course Name</th>
            <th class="py-3 px-4 w-64">Completed</th>
            <th class="py-3 px-4 text-right">Materi</th>
            <th class="py-3 px-4 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100/80 dark:divide-slate-800">
          <% courses.forEach((course, index) => { %>
          <!-- Baris Utama Kursus -->
          <tr class="course-row hover:bg-slate-50/70 dark:hover:bg-slate-800/50 transition-colors group cursor-pointer" 
              data-type="<%= course.isFinished ? 'completed' : 'active' %>">
            
            <td class="py-4 px-2 text-xs font-semibold text-slate-400">
              <button type="button" 
                      onclick="toggleDashboardCourseTree(event, '<%= course.id %>')" 
                      class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-brand-100 dark:hover:bg-slate-700 text-slate-400 hover:text-brand-600 transition-colors" 
                      title="Buka / Tutup Turunan Bab & Materi">
                <svg id="dashboardTreeArrow-<%= course.id %>" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
            </td>

            <td class="py-4 px-4" onclick="window.location.href='/courses/<%= course.slug %>'">
              <div class="flex items-center gap-3.5">
                <div class="w-10 h-10 rounded-xl overflow-hidden shrink-0 shadow-xs border border-slate-100 dark:border-slate-700">
                  <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover">
                </div>
                <div>
                  <h4 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100 group-hover:text-brand-500 transition-colors line-clamp-1">
                    <%= course.title %>
                  </h4>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-[10px] text-slate-400 font-medium"><%= course.category %></span>
                    <span class="text-[10px] text-brand-600 dark:text-brand-400 font-semibold bg-brand-50 dark:bg-slate-800 px-2 py-0.5 rounded-md border border-brand-100 dark:border-slate-700 inline-flex items-center gap-1">
                      <svg class="w-3 h-3 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
                      <span><%= (course.chapters ? course.chapters.length : 0) %> Bab</span>
                    </span>
                  </div>
                </div>
              </div>
            </td>

            <td class="py-4 px-4" onclick="window.location.href='/courses/<%= course.slug %>'">
              <div class="flex items-center gap-3">
                <div class="flex-1 bg-slate-100 dark:bg-slate-700 h-2 rounded-full overflow-hidden">
                  <div class="h-full rounded-full transition-all duration-500 dashboard-bar" 
                       data-progress="<%= course.percent || 0 %>" data-color="<%= course.barColor || '#6c5dd3' %>">
                  </div>
                </div>
                <span class="text-xs font-bold text-slate-600 dark:text-slate-300 w-9 text-right"><%= course.percent %>%</span>
              </div>
            </td>

            <td class="py-4 px-4 text-right">
              <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                <%= course.completed_lessons || 0 %> / <%= course.total_lessons || 0 %> materi
              </span>
            </td>

            <td class="py-4 px-4 text-right">
              <a href="/courses/<%= course.slug %>" class="px-3 py-1.5 rounded-xl bg-brand-50 dark:bg-slate-800 hover:bg-brand-100 dark:hover:bg-slate-700 text-brand-500 dark:text-brand-400 text-xs font-bold inline-block transition-colors">
                Buka →
              </a>
            </td>

          </tr>

          <!-- Baris Expandable Turunan Kursus Tabel -->
          <tr id="dashboardTreeRow-<%= course.id %>" class="hidden bg-slate-50/80 dark:bg-slate-850/80 border-b border-slate-100 dark:border-slate-800">
            <td colspan="5" class="p-0">
              <div class="px-6 py-4 pl-12 bg-gradient-to-b from-slate-50/90 to-white dark:from-slate-900/90 dark:to-slate-900 border-y border-slate-100/80 dark:border-slate-800 space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-bold text-brand-500 uppercase tracking-wider flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-brand-500"></span>
                    Turunan Modul: <span class="text-slate-800 dark:text-slate-100 normal-case font-extrabold"><%= course.title %></span>
                  </span>
                  <a href="/courses/<%= course.slug %>" class="text-xs font-bold text-brand-500 hover:underline flex items-center gap-1">
                    <span>Lihat Halaman Kursus Lengkap</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                  </a>
                </div>

                <!-- Pohon Turunan Bab & Materi -->
                <div class="space-y-3 pl-3 border-l-2 border-brand-200 dark:border-brand-800 ml-1">
                  <% if (course.chapters && course.chapters.length > 0) { %>
                    <% course.chapters.forEach((ch, chIdx) => { %>
                      <div class="bg-white dark:bg-slate-800/90 rounded-xl p-3.5 border border-slate-100 dark:border-slate-700 shadow-xs">
                        <div class="flex items-center justify-between text-xs font-bold text-slate-800 dark:text-slate-100 pb-2 border-b border-slate-100 dark:border-slate-700">
                          <span class="flex items-center gap-2">
                            <span class="w-5 h-5 rounded-md bg-brand-50 dark:bg-slate-700 text-brand-600 dark:text-brand-300 text-[10px] flex items-center justify-center font-bold">
                              <%= chIdx + 1 %>
                            </span>
                            <span><%= ch.title %></span>
                          </span>
                          <span class="text-[10px] text-slate-400 font-semibold"><%= ch.lessons ? ch.lessons.length : 0 %> Materi</span>
                        </div>

                        <div class="mt-2 space-y-1 pl-4">
                          <% if (ch.lessons && ch.lessons.length > 0) { %>
                            <% ch.lessons.forEach(l => { %>
                              <a href="/learn/<%= course.slug %>/<%= l.id %>" class="flex items-center justify-between py-1.5 px-2.5 rounded-lg hover:bg-brand-50/60 dark:hover:bg-slate-700/60 text-xs transition-colors group">
                                <div class="flex items-center gap-2 min-w-0">
                                  <span class="w-4 h-4 rounded-full flex items-center justify-center text-[10px] shrink-0 <%= l.is_completed ? 'bg-emerald-500 text-white font-bold' : 'border border-slate-300 text-transparent' %>">
                                    ✓
                                  </span>
                                  <span class="text-slate-700 group-hover:text-violet-700 font-medium truncate"><%= l.title %></span>
                                </div>
                                <div class="flex items-center gap-3 text-[10px] text-slate-400 shrink-0 ml-2">
                                  <span><%= l.duration_minutes %> menit</span>
                                  <span class="text-brand-600 font-bold group-hover:underline">Buka Materi →</span>
                                </div>
                              </a>
                            <% }) %>
                          <% } else { %>
                            <span class="text-[10px] text-slate-400 italic">Belum ada materi di bab ini.</span>
                          <% } %>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <span class="text-xs text-slate-400 italic">Belum ada bab turunan untuk kursus ini.</span>
                  <% } %>
                </div>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </div>

</div>

<script>
  // Switch Antara Grid Bento View vs Table View
  function switchCourseView(viewType) {
    const gridView = document.getElementById('courseGridView');
    const tableView = document.getElementById('courseTableView');
    const gridBtn = document.getElementById('viewGridBtn');
    const tableBtn = document.getElementById('viewTableBtn');

    if (viewType === 'grid') {
      gridView.classList.remove('hidden');
      tableView.classList.add('hidden');
      gridBtn.className = "px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1.5 bg-white text-slate-900 shadow-xs";
      tableBtn.className = "px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1.5 text-slate-500 hover:text-slate-800";
      localStorage.setItem('kyzoo_course_view', 'grid');
    } else {
      gridView.classList.add('hidden');
      tableView.classList.remove('hidden');
      tableBtn.className = "px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1.5 bg-white text-slate-900 shadow-xs";
      gridBtn.className = "px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1.5 text-slate-500 hover:text-slate-800";
      localStorage.setItem('kyzoo_course_view', 'table');
    }
  }

  // Cek preferensi view tersimpan di browser
  const savedView = localStorage.getItem('kyzoo_course_view');
  if (savedView === 'table') {
    switchCourseView('table');
  }

  // Toggle Accordion Turunan Bab di Bento Card
  function toggleBentoChapterDrawer(e, courseId) {
    if (e) e.stopPropagation();
    const drawer = document.getElementById('bentoChapterDrawer-' + courseId);
    const icon = document.getElementById('bentoDrawerIcon-' + courseId);
    if (!drawer) return;

    if (drawer.classList.contains('hidden')) {
      drawer.classList.remove('hidden');
      if (icon) icon.classList.add('rotate-180', 'text-violet-600');
    } else {
      drawer.classList.add('hidden');
      if (icon) icon.classList.remove('rotate-180', 'text-violet-600');
    }
  }

  // Toggle Pohon Turunan Kursus di Desktop Table
  function toggleDashboardCourseTree(e, courseId) {
    if (e) e.stopPropagation();
    const row = document.getElementById('dashboardTreeRow-' + courseId);
    const arrow = document.getElementById('dashboardTreeArrow-' + courseId);
    if (!row) return;

    if (row.classList.contains('hidden')) {
      row.classList.remove('hidden');
      if (arrow) arrow.classList.add('rotate-90', 'text-violet-600');
    } else {
      row.classList.add('hidden');
      if (arrow) arrow.classList.remove('rotate-90', 'text-violet-600');
    }
  }

  // Filter Active / Completed
  function switchCourseTab(type) {
    const activeBtn = document.getElementById('tabActiveBtn');
    const compBtn = document.getElementById('tabCompletedBtn');
    const items = document.querySelectorAll('.course-bento-card, .course-row');

    if (type === 'active') {
      activeBtn.className = "px-3 py-1.5 rounded-lg transition-all bg-white text-violet-700 shadow-xs";
      compBtn.className = "px-3 py-1.5 rounded-lg transition-all text-slate-500 hover:text-slate-800";
      items.forEach(el => {
        if (el.getAttribute('data-type') === 'active') {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    } else {
      compBtn.className = "px-3 py-1.5 rounded-lg transition-all bg-white text-violet-700 shadow-xs";
      activeBtn.className = "px-3 py-1.5 rounded-lg transition-all text-slate-500 hover:text-slate-800";
      items.forEach(el => {
        if (el.getAttribute('data-type') === 'completed') {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    }
  }

  // Live Search Input Handler
  const heroSearchInput = document.getElementById('heroSearchInput');
  const heroSearchResults = document.getElementById('heroSearchResults');
  let searchTimer = null;

  if (heroSearchInput && heroSearchResults) {
    heroSearchInput.addEventListener('input', (e) => {
      const query = e.target.value.trim();
      clearTimeout(searchTimer);

      // 1. Live Filter Kursus di Halaman Dashboard (Bento Cards & Baris Tabel)
      const filterTerm = query.toLowerCase();
      const courseItems = document.querySelectorAll('.course-bento-card, .course-row');
      courseItems.forEach(item => {
        const text = item.textContent.toLowerCase();
        if (!filterTerm || text.includes(filterTerm)) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });

      // 2. Jika query kosong, sembunyikan dropdown
      if (!query) {
        heroSearchResults.classList.add('hidden');
        heroSearchResults.innerHTML = '';
        return;
      }

      // 3. Debounce AJAX Live Search ke /api/search
      searchTimer = setTimeout(async () => {
        try {
          const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
          const data = await res.json();
          renderSearchResults(data, query);
        } catch (err) {
          console.error('Search error:', err);
        }
      }, 200);
    });

    // Sembunyikan dropdown jika klik di luar
    document.addEventListener('click', (e) => {
      if (!heroSearchInput.contains(e.target) && !heroSearchResults.contains(e.target)) {
        heroSearchResults.classList.add('hidden');
      }
    });

    // Tombol Escape menutup dropdown
    heroSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        heroSearchResults.classList.add('hidden');
      }
    });
  }

  function renderSearchResults(data, query) {
    const { courses, lessons } = data;
    if (courses.length === 0 && lessons.length === 0) {
      heroSearchResults.innerHTML = `
        <div class="p-4 text-xs text-slate-500 text-center">
          Tidak ditemukan modul atau materi yang cocok dengan "<span class="text-slate-800 font-bold">${escapeHtml(query)}</span>"
        </div>
      `;
      heroSearchResults.classList.remove('hidden');
      return;
    }

    let html = '';

    // Modul Kursus
    if (courses.length > 0) {
      html += `
        <div class="px-3.5 py-2 bg-slate-50 dark:bg-slate-800 text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-100 dark:border-slate-700/60 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
          <span>Modul Kursus</span>
        </div>
        <div class="p-1 space-y-0.5">
      `;
      courses.forEach(c => {
        html += `
          <a href="/courses/${c.slug}" class="flex items-center gap-3 p-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-colors group">
            <img src="${c.thumbnail}" class="w-8 h-8 rounded-lg object-cover shrink-0 border border-slate-200/80 dark:border-slate-700">
            <div class="min-w-0 flex-1">
              <h5 class="text-xs font-semibold text-slate-900 dark:text-white group-hover:text-brand-500 truncate">${escapeHtml(c.title)}</h5>
              <span class="text-[10px] text-slate-400">${escapeHtml(c.category)}</span>
            </div>
          </a>
        `;
      });
      html += `</div>`;
    }

    // Materi Pembelajaran
    if (lessons.length > 0) {
      html += `
        <div class="px-3.5 py-2 bg-slate-50 dark:bg-slate-800 text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-100 dark:border-slate-700/60 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>Materi Pembelajaran</span>
        </div>
        <div class="p-1 space-y-0.5">
      `;
      lessons.forEach(l => {
        html += `
          <a href="/learn/${l.course_slug}/${l.id}" class="flex items-center justify-between p-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-colors group">
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="w-6 h-6 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              </span>
              <div class="min-w-0">
                <h5 class="text-xs font-semibold text-slate-900 dark:text-white group-hover:text-brand-500 truncate">${escapeHtml(l.title)}</h5>
                <span class="text-[10px] text-slate-400">${escapeHtml(l.course_title)}</span>
              </div>
            </div>
            <span class="text-[10px] text-slate-400 shrink-0 ml-2 font-mono">${l.duration_minutes}m</span>
          </a>
        `;
      });
      html += `</div>`;
    }

    heroSearchResults.innerHTML = html;
    heroSearchResults.classList.remove('hidden');
  }

  function escapeHtml(text) {
    if (!text) return '';
    return text.replace(/[&<>"']/g, m => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    })[m]);
  }

  // Inisialisasi visual progress bar aman tanpa error linter
  (function() {
    document.querySelectorAll('.dashboard-bar').forEach(el => {
      const p = el.getAttribute('data-progress') || 0;
      const c = el.getAttribute('data-color');
      el.style.width = p + '%';
      if (c) el.style.backgroundColor = c;
    });
  })();
</script>
