<!DOCTYPE html>
<html lang="id" class="h-full bg-[#f8fafc]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Kyzoo LMS' %></title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f5f3ff',
              100: '#ede9fe',
              500: '#6c5dd3',
              600: '#5b4dc2',
              700: '#4a3da8'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif']
          }
        }
      }
    }
  </script>

  <!-- Google Fonts Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    body { font-family: 'Inter', sans-serif; }
    /* Circular Progress Ring */
    .progress-ring__circle {
      transition: stroke-dashoffset 0.5s ease-in-out;
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }
    /* Scrollbar halus */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  </style>
</head>
<body class="h-full flex flex-col text-slate-800 antialiased selection:bg-violet-500 selection:text-white">

  <div class="flex-1 flex overflow-hidden">
    <!-- Sidebar Kiri -->
    <%- include('partials/sidebar') %>

    <!-- Area Konten Utama -->
    <div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
      <!-- Topbar Header -->
      <%- include('partials/topbar') %>

      <!-- Wadah Konten Dinamis -->
      <div class="flex-1 flex">
        <main class="flex-1 p-4 sm:p-6 lg:p-8 w-full max-w-7xl pb-24 md:pb-8">
          <%- body %>
        </main>
      </div>
    </div>
  </div>

  <!-- Mobile Bottom Navigation Bar (Khusus Tampilan Layar HP) -->
  <nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200/80 px-4 py-2 flex items-center justify-around shadow-lg">
    <!-- Home / Dashboard -->
    <a href="/dashboard" class="flex flex-col items-center gap-1 text-[10px] font-bold py-1 px-2 rounded-lg transition-colors <%= (typeof currentPath !== 'undefined' && currentPath === '/dashboard') ? 'text-[#6c5dd3]' : 'text-slate-400 hover:text-slate-700' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <rect x="3" y="3" width="7" height="7" rx="1.5" stroke-width="2"></rect>
        <rect x="14" y="3" width="7" height="7" rx="1.5" stroke-width="2"></rect>
        <rect x="14" y="14" width="7" height="7" rx="1.5" stroke-width="2"></rect>
        <rect x="3" y="14" width="7" height="7" rx="1.5" stroke-width="2"></rect>
      </svg>
      <span>Dashboard</span>
    </a>

    <!-- Courses -->
    <a href="/courses" class="flex flex-col items-center gap-1 text-[10px] font-bold py-1 px-2 rounded-lg transition-colors <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/courses')) ? 'text-[#6c5dd3]' : 'text-slate-400 hover:text-slate-700' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
      </svg>
      <span>Kursus</span>
    </a>

    <!-- Khusus Admin: Akses CMS -->
    <% if (currentUser && currentUser.role === 'admin') { %>
    <a href="/admin" class="flex flex-col items-center gap-1 text-[10px] font-bold py-1 px-2 rounded-lg transition-colors <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin')) ? 'text-amber-600' : 'text-slate-400 hover:text-slate-700' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
      </svg>
      <span>Admin</span>
    </a>
    <% } %>

    <!-- Help -->
    <a href="/help" class="flex flex-col items-center gap-1 text-[10px] font-bold py-1 px-2 rounded-lg transition-colors <%= (typeof currentPath !== 'undefined' && currentPath === '/help') ? 'text-[#6c5dd3]' : 'text-slate-400 hover:text-slate-700' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="9" stroke-width="2"></circle>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3m.08 4h.01"></path>
      </svg>
      <span>Bantuan</span>
    </a>

    <!-- Profil -->
    <a href="/settings" class="flex flex-col items-center gap-1 text-[10px] font-bold py-1 px-2 rounded-lg transition-colors <%= (typeof currentPath !== 'undefined' && currentPath === '/settings') ? 'text-[#6c5dd3]' : 'text-slate-400 hover:text-slate-700' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
      </svg>
      <span>Profil</span>
    </a>
  </nav>

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Client JavaScript -->
  <script src="/js/app.js"></script>
</body>
</html>
