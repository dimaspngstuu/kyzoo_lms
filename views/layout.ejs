<!DOCTYPE html>
<html lang="id" class="h-full bg-[#f8fafc]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Kyzoo LMS' %></title>
  <link rel="icon" type="image/png" href="/images/logo-icon.png">
  
  <!-- Script Inisialisasi Tema Instan (Mode Terang Permanen & Warna Aksen) -->
  <script>
    (function() {
      try {
        document.documentElement.classList.remove('dark');
        localStorage.removeItem('kyzoo_theme_mode');
        const savedAccent = localStorage.getItem('kyzoo_theme_accent') || 'violet';
        document.documentElement.setAttribute('data-accent', savedAccent);
      } catch (e) {}
    })();
  </script>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: 'var(--brand-50, #f5f3ff)',
              100: 'var(--brand-100, #ede9fe)',
              200: 'var(--brand-200, #ddd6fe)',
              500: 'var(--brand-500, #6c5dd3)',
              600: 'var(--brand-600, #5b4dc2)',
              700: 'var(--brand-700, #4a3da8)'
            }
          },
          fontFamily: {
            sans: ['"Outfit"', 'system-ui', '-apple-system', 'sans-serif'],
            serif: ['"Instrument Serif"', 'Georgia', 'serif'],
            accent: ['"Instrument Serif"', 'Georgia', 'serif']
          }
        }
      }
    }
  </script>

  <!-- Google Fonts: Outfit (Humanist Geometric Sans) & Instrument Serif (Editorial Luxury Italic) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <style>
    body {
      font-family: 'Outfit', system-ui, -apple-system, sans-serif;
    }
    .font-serif, .font-accent {
      font-family: 'Instrument Serif', Georgia, serif;
    }

    /* CSS Variables untuk Sistem Warna Aksen Dinamis */
    :root, [data-accent="violet"] {
      --brand-50: #f5f3ff;
      --brand-100: #ede9fe;
      --brand-200: #ddd6fe;
      --brand-500: #6c5dd3;
      --brand-600: #5b4dc2;
      --brand-700: #4a3da8;
      --brand-glow: rgba(108, 93, 211, 0.28);
      --brand-gradient: linear-gradient(135deg, #6c5dd3 0%, #8b5cf6 100%);
    }
    [data-accent="ocean"] {
      --brand-50: #f0f9ff;
      --brand-100: #e0f2fe;
      --brand-200: #bae6fd;
      --brand-500: #0284c7;
      --brand-600: #0369a1;
      --brand-700: #075985;
      --brand-glow: rgba(2, 132, 199, 0.28);
      --brand-gradient: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);
    }
    [data-accent="emerald"] {
      --brand-50: #ecfdf5;
      --brand-100: #d1fae5;
      --brand-200: #a7f3d0;
      --brand-500: #10b981;
      --brand-600: #059669;
      --brand-700: #047857;
      --brand-glow: rgba(16, 185, 129, 0.28);
      --brand-gradient: linear-gradient(135deg, #10b981 0%, #34d399 100%);
    }
    [data-accent="coral"] {
      --brand-50: #fff7ed;
      --brand-100: #ffedd5;
      --brand-200: #fed7aa;
      --brand-500: #f97316;
      --brand-600: #ea580c;
      --brand-700: #c2410c;
      --brand-glow: rgba(249, 115, 22, 0.28);
      --brand-gradient: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
    }

    body { 
      font-family: 'Urbanist', sans-serif;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    /* Helper Class Khusus Tema Dinamis */
    .bg-dynamic-accent { background-color: var(--brand-500) !important; }
    .text-dynamic-accent { color: var(--brand-500) !important; }
    .border-dynamic-accent { border-color: var(--brand-500) !important; }
    .bg-dynamic-subtle { background-color: var(--brand-50) !important; }
    .shadow-dynamic-glow { box-shadow: 0 10px 25px -5px var(--brand-glow) !important; }

    /* Circular Progress Ring */
    .progress-ring__circle {
      transition: stroke-dashoffset 0.5s ease-in-out;
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }

    /* Scrollbar halus adaptif dark & light */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    html.dark ::-webkit-scrollbar-thumb { background: #334155; border-radius: 9999px; }
    html.dark ::-webkit-scrollbar-thumb:hover { background: #475569; }
    html:not(.dark) ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
    html:not(.dark) ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  </style>
</head>
<body class="h-full flex flex-col text-slate-800 dark:text-slate-100 bg-[#f8fafc] dark:bg-slate-950 antialiased selection:bg-brand-500 selection:text-white">

  <div class="flex-1 flex overflow-hidden">
    <!-- Sidebar Kiri -->
    <%- include('partials/sidebar') %>

    <!-- Area Konten Utama -->
    <div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
      <!-- Topbar Header -->
      <%- include('partials/topbar') %>

      <!-- Wadah Konten Dinamis -->
      <div class="flex-1 flex">
        <main class="flex-1 p-4 sm:p-6 lg:p-8 w-full max-w-7xl pb-24 md:pb-8">
          <%- body %>
        </main>
      </div>
    </div>
  </div>

  <!-- Mobile Bottom Navigation Bar (Khusus Tampilan Layar HP) -->
  <nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-t border-slate-200/80 dark:border-slate-800 px-4 py-2 flex items-center justify-around shadow-lg">
    <!-- Home / Dashboard -->
    <a href="/dashboard" class="flex flex-col items-center gap-1 text-[10px] font-bold py-1 px-2 rounded-lg transition-colors <%= (typeof currentPath !== 'undefined' && currentPath === '/dashboard') ? 'text-brand-500' : 'text-slate-400 hover:text-slate-700 dark:hover:text-slate-200' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <rect x="3" y="3" width="7" height="7" rx="1.5" stroke-width="2"></rect>
        <rect x="14" y="3" width="7" height="7" rx="1.5" stroke-width="2"></rect>
        <rect x="14" y="14" width="7" height="7" rx="1.5" stroke-width="2"></rect>
        <rect x="3" y="14" width="7" height="7" rx="1.5" stroke-width="2"></rect>
      </svg>
      <span>Dashboard</span>
    </a>

    <!-- Courses -->
    <a href="/courses" class="flex flex-col items-center gap-1 text-[10px] font-bold py-1 px-2 rounded-lg transition-colors <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/courses')) ? 'text-brand-500' : 'text-slate-400 hover:text-slate-700 dark:hover:text-slate-200' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
      </svg>
      <span>Kursus</span>
    </a>

    <!-- Khusus Admin: Akses CMS -->
    <% if (currentUser && currentUser.role === 'admin') { %>
    <a href="/admin" class="flex flex-col items-center gap-1 text-[10px] font-bold py-1 px-2 rounded-lg transition-colors <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin')) ? 'text-amber-500' : 'text-slate-400 hover:text-slate-700 dark:hover:text-slate-200' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
      </svg>
      <span>Admin</span>
    </a>
    <% } %>

    <!-- Profil -->
    <a href="/settings" class="flex flex-col items-center gap-1 text-[10px] font-bold py-1 px-2 rounded-lg transition-colors <%= (typeof currentPath !== 'undefined' && currentPath === '/settings') ? 'text-brand-500' : 'text-slate-400 hover:text-slate-700 dark:hover:text-slate-200' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
      </svg>
      <span>Profil</span>
    </a>
  </nav>

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Client JavaScript -->
  <script src="/js/app.js"></script>
</body>
</html>
