<!-- Topbar Header ala Quyl / Kyzoo (Interaktif & Dukung Tema Dinamis) -->
<header class="bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-slate-100 dark:border-slate-800 px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between gap-3 sm:gap-4 sticky top-0 z-30 transition-colors duration-300">
  <div class="flex items-center gap-3">
    <!-- Tombol Hamburger Mobile -->
    <button id="openSidebarBtn" class="md:hidden text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
    <!-- Logo Brand di Topbar Mobile -->
    <a href="/dashboard" class="md:hidden flex items-center">
      <img src="/images/logo-horizontal.png" alt="Kyzoo" class="h-8 w-auto object-contain" />
    </a>
    <!-- Judul Halaman Desktop -->
    <h1 class="text-xl font-bold text-slate-800 dark:text-white tracking-tight hidden md:block">
      <%= typeof pageTitle !== 'undefined' ? pageTitle : (typeof title !== 'undefined' ? title.split('-')[0].trim() : 'Dashboard') %>
    </h1>
  </div>

  <!-- Search Bar Tengah (Hanya aktif di luar Dashboard agar tidak dobel dengan hero search) -->
  <% if (typeof currentPath !== 'undefined' && currentPath !== '/dashboard') { %>
  <div class="flex-1 max-w-md mx-4 hidden sm:block">
    <form action="/courses" method="GET" class="relative">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <input 
        type="text" 
        name="q" 
        placeholder="Cari materi tutorial..." 
        value="<%= typeof search !== 'undefined' ? search : '' %>"
        class="w-full pl-10 pr-4 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 rounded-xl text-xs sm:text-sm text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all"
      />
    </form>
  </div>
  <% } else { %>
  <div class="flex-1 hidden md:block"></div>
  <% } %>

  <!-- Area Kanan: Theme Customizer & Profil Pengguna -->
  <div class="flex items-center gap-2 sm:gap-3">
    <!-- 🎨 Interaktif Theme Customizer Dropdown (Warna Aksen Kyzoo) -->
    <div class="relative" id="themeDropdownContainer">
      <button 
        id="themeDropdownBtn" 
        type="button" 
        class="flex items-center gap-1.5 sm:gap-2 px-2 sm:px-3 py-1.5 rounded-xl border border-slate-200/80 bg-slate-50/80 text-slate-700 hover:bg-slate-100 transition-all text-xs font-bold shadow-2xs group"
        title="Sesuaikan Warna Aksen Kyzoo"
      >
        <!-- Dot Warna Aksen Aktif -->
        <span id="activeAccentDot" class="w-2.5 h-2.5 rounded-full bg-brand-500 ring-2 ring-white shadow-2xs"></span>
        <span class="hidden sm:inline text-[11px] font-semibold text-slate-500">Warna Aksen</span>
        <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-600 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>

      <!-- Panel Dropdown Pengaturan Warna Aksen -->
      <div 
        id="themeDropdownMenu" 
        class="hidden absolute right-0 mt-2 w-56 bg-white rounded-2xl border border-slate-200/90 shadow-2xl p-3.5 z-50 text-slate-800 animate-in fade-in zoom-in-95 duration-150"
      >
        <!-- Palet Warna Aksen Interaktif -->
        <div>
          <div class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-2">Warna Aksen Kyzoo</div>
          <div class="grid grid-cols-4 gap-1.5">
            <!-- Violet -->
            <button type="button" data-accent="violet" class="accent-btn flex flex-col items-center gap-1 p-1.5 rounded-xl border border-transparent hover:bg-slate-50 transition-all text-center">
              <span class="w-6 h-6 rounded-full bg-[#6c5dd3] shadow-xs flex items-center justify-center text-white text-[10px] font-black">✓</span>
              <span class="text-[9px] font-bold text-slate-600">Violet</span>
            </button>
            <!-- Ocean Blue -->
            <button type="button" data-accent="ocean" class="accent-btn flex flex-col items-center gap-1 p-1.5 rounded-xl border border-transparent hover:bg-slate-50 transition-all text-center">
              <span class="w-6 h-6 rounded-full bg-[#0284c7] shadow-xs flex items-center justify-center text-white text-[10px] font-black"></span>
              <span class="text-[9px] font-bold text-slate-600">Ocean</span>
            </button>
            <!-- Mint Emerald -->
            <button type="button" data-accent="emerald" class="accent-btn flex flex-col items-center gap-1 p-1.5 rounded-xl border border-transparent hover:bg-slate-50 transition-all text-center">
              <span class="w-6 h-6 rounded-full bg-[#10b981] shadow-xs flex items-center justify-center text-white text-[10px] font-black"></span>
              <span class="text-[9px] font-bold text-slate-600">Mint</span>
            </button>
            <!-- Sunset Coral -->
            <button type="button" data-accent="coral" class="accent-btn flex flex-col items-center gap-1 p-1.5 rounded-xl border border-transparent hover:bg-slate-50 transition-all text-center">
              <span class="w-6 h-6 rounded-full bg-[#f97316] shadow-xs flex items-center justify-center text-white text-[10px] font-black"></span>
              <span class="text-[9px] font-bold text-slate-600">Coral</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- User Profile Avatar & Name -->
    <a href="/settings" class="relative flex items-center gap-2.5 p-1 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
      <img 
        src="<%= (currentUser && currentUser.avatar) ? currentUser.avatar : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80' %>" 
        alt="Avatar" 
        class="w-9 h-9 rounded-full object-cover ring-2 ring-brand-100 dark:ring-slate-700 shrink-0"
      />
      <div class="hidden sm:block text-left">
        <div class="text-xs font-bold text-slate-800 dark:text-slate-100 leading-tight">
          <%= currentUser ? currentUser.name : 'Member Kyzoo' %>
        </div>
        <div class="text-[10px] font-semibold text-brand-500 uppercase tracking-wider">
          <%= currentUser ? (currentUser.role === 'admin' ? 'Administrator' : 'Pelanggan') : 'Pelanggan' %>
        </div>
      </div>
      <svg class="w-3.5 h-3.5 text-slate-400 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </a>
  </div>
</header>
