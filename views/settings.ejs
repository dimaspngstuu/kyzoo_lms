<!-- Halaman Pengaturan Akun -->

<div class="space-y-6 max-w-2xl">
  <div class="bg-white rounded-[22px] border border-slate-100 p-6 shadow-sm">
    <h2 class="text-xl font-bold text-slate-900 mb-1">Pengaturan Profil</h2>
    <p class="text-xs text-slate-400">Informasi akun Anda di sistem Kyzoo LMS.</p>

    <div class="mt-6 flex items-center gap-4 pb-6 border-b border-slate-100">
      <img src="<%= user.avatar %>" alt="<%= user.name %>" class="w-16 h-16 rounded-2xl object-cover ring-4 ring-violet-50">
      <div>
        <h3 class="text-base font-bold text-slate-900"><%= user.name %></h3>
        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-violet-50 text-violet-700">
          Role: <%= user.role === 'admin' ? 'Administrator' : 'Pelanggan' %>
        </span>
      </div>
    </div>

    <div class="mt-6 space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-600 mb-1">Alamat Email</label>
        <input type="text" disabled value="<%= user.email %>" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-500">
      </div>

      <div class="pt-4 flex justify-end">
        <a href="/dashboard" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition-colors">
          Kembali ke Dashboard
        </a>
      </div>
    </div>
  </div>
</div>
