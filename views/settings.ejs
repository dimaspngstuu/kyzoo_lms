<!-- Halaman Pengaturan Akun & Keamanan (Kyzoo LMS) -->

<div class="space-y-6 max-w-2xl">
  
  <!-- Notifikasi Pesan Sukses / Error -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs sm:text-sm font-semibold rounded-2xl flex items-center gap-3 shadow-xs">
      <div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm font-semibold rounded-2xl flex items-center gap-3 shadow-xs">
      <div class="w-7 h-7 rounded-lg bg-rose-100 text-rose-700 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- KARTU 1: Informasi Profil & Alamat Email Terdaftar -->
  <div class="bg-white dark:bg-slate-900 rounded-[22px] border border-slate-100 dark:border-slate-800 p-6 shadow-sm space-y-6 transition-colors">
    <div>
      <h2 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">Pengaturan Profil</h2>
      <p class="text-xs text-slate-400 mt-0.5">Informasi akun Anda di sistem Kyzoo LMS.</p>
    </div>

    <!-- Info User (Avatar dengan Fitur Ganti Foto, Nama, Role, Status) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5 pb-6 border-b border-slate-100 dark:border-slate-800">
      <div class="flex items-center gap-4">
        <!-- Wadah Avatar dengan Tombol Kamera & Preview -->
        <div class="relative group shrink-0">
          <img id="avatarImagePreview" src="<%= user.avatar %>" alt="<%= user.name %>" class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover ring-4 ring-brand-50 dark:ring-brand-950/60 border border-slate-200 dark:border-slate-700 shadow-sm transition-transform group-hover:scale-102">
          
          <button type="button" onclick="document.getElementById('avatarFileInput').click()" class="absolute inset-0 bg-slate-900/60 rounded-2xl opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center text-white text-[10px] font-bold transition-opacity cursor-pointer backdrop-blur-2xs" title="Ganti Foto Profil">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span>Ubah</span>
          </button>
        </div>

        <div>
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white"><%= user.name %></h3>
          <div class="flex items-center gap-2 mt-1 flex-wrap">
            <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-brand-50 dark:bg-brand-950/60 text-brand-600 dark:text-brand-400 border border-brand-100 dark:border-brand-900/60">
              Role: <%= user.role === 'admin' ? 'Administrator' : 'Pelanggan' %>
            </span>
            <span class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-2.5 py-0.5 rounded-full border border-emerald-100 dark:border-emerald-900/40 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Akun Terdaftar
            </span>
          </div>
        </div>
      </div>

      <!-- Form Upload Foto Profil Mandiri -->
      <form id="avatarForm" action="/settings/avatar" method="POST" enctype="multipart/form-data" class="flex flex-col sm:items-end gap-2">
        <input type="file" id="avatarFileInput" name="avatar_file" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" onchange="handleAvatarSelected(this)">
        
        <button type="button" onclick="document.getElementById('avatarFileInput').click()" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold transition-all flex items-center gap-2 shadow-xs cursor-pointer self-start sm:self-auto">
          <svg class="w-4 h-4 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          <span>Ganti Foto Profil</span>
        </button>

        <div id="avatarSaveBox" class="hidden flex items-center gap-2 mt-1">
          <button type="submit" class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white rounded-xl text-xs font-bold shadow-md shadow-dynamic-glow transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
            <span>Simpan Foto Baru</span>
          </button>
          <button type="button" onclick="cancelAvatarSelection()" class="px-2.5 py-2 text-xs text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 font-semibold cursor-pointer">
            Batal
          </button>
        </div>
      </form>
    </div>

    <!-- Kolom Alamat Email (Permanen / Tidak Bisa Diubah) -->
    <div class="space-y-2.5">
      <div class="flex items-center justify-between">
        <label class="block text-xs font-bold text-slate-700">Alamat Email Terdaftar</label>
        <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-md">
          <svg class="w-3 h-3 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
          Terkunci & Tidak Dapat Diubah
        </span>
      </div>

      <div class="relative">
        <input type="text" 
               readonly 
               value="<%= user.email %>" 
               class="w-full px-4 py-2.5 bg-slate-100/90 border border-slate-200 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 cursor-not-allowed select-none focus:outline-none shadow-xs">
        <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
        </div>
      </div>

      <!-- Informasi Penjelasan Terkait Email Terdaftar -->
      <div class="p-3.5 bg-slate-50 border border-slate-200/80 rounded-xl flex items-start gap-3">
        <div class="w-6 h-6 rounded-md bg-violet-100 text-violet-700 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div class="text-[11px] sm:text-xs text-slate-500 leading-relaxed">
          <strong class="text-slate-800">Informasi Email Akun:</strong> Alamat email ini terdaftar permanen sebagai identitas login utama Anda di sistem Kyzoo LMS dan terhubung langsung dengan seluruh riwayat progres belajar, materi kursus, dan sertifikat. Demi menjaga keamanan akun dan integritas data pelanggan, email tidak dapat diubah secara mandiri.
        </div>
      </div>
    </div>
  </div>

  <!-- KARTU 2: Opsi Ganti Kata Sandi (Password) -->
  <div class="bg-white rounded-[22px] border border-slate-100 p-6 shadow-sm space-y-5">
    <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
      <div class="w-9 h-9 rounded-xl bg-violet-50 text-violet-700 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
      </div>
      <div>
        <h3 class="text-sm sm:text-base font-bold text-slate-900">Ubah Kata Sandi</h3>
        <p class="text-xs text-slate-400">Gunakan kombinasi kata sandi yang aman untuk melindungi akses belajar Anda.</p>
      </div>
    </div>

    <form action="/settings/password" method="POST" class="space-y-4">
      <!-- Kata Sandi Lama / Saat Ini -->
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">Kata Sandi Saat Ini</label>
        <div class="relative">
          <input type="password" 
                 id="currentPasswordInput"
                 name="currentPassword" 
                 required 
                 placeholder="Masukkan kata sandi saat ini" 
                 class="w-full pl-4 pr-11 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-violet-500/20 focus:border-violet-500 transition-all">
          <button type="button" 
                  onclick="togglePasswordVisibility('currentPasswordInput', this)" 
                  class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 transition-colors"
                  title="Lihat / Sembunyikan Kata Sandi">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
          </button>
        </div>
      </div>

      <!-- Kata Sandi Baru -->
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">Kata Sandi Baru</label>
        <div class="relative">
          <input type="password" 
                 id="newPasswordInput"
                 name="newPassword" 
                 required 
                 minlength="6"
                 placeholder="Minimal 6 karakter" 
                 class="w-full pl-4 pr-11 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-violet-500/20 focus:border-violet-500 transition-all">
          <button type="button" 
                  onclick="togglePasswordVisibility('newPasswordInput', this)" 
                  class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 transition-colors"
                  title="Lihat / Sembunyikan Kata Sandi">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
          </button>
        </div>
      </div>

      <!-- Konfirmasi Kata Sandi Baru -->
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1.5">Konfirmasi Kata Sandi Baru</label>
        <div class="relative">
          <input type="password" 
                 id="confirmPasswordInput"
                 name="confirmPassword" 
                 required 
                 minlength="6"
                 placeholder="Ulangi kata sandi baru" 
                 class="w-full pl-4 pr-11 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-violet-500/20 focus:border-violet-500 transition-all">
          <button type="button" 
                  onclick="togglePasswordVisibility('confirmPasswordInput', this)" 
                  class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 transition-colors"
                  title="Lihat / Sembunyikan Kata Sandi">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
          </button>
        </div>
      </div>

      <!-- Baris Aksi -->
      <div class="pt-3 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-slate-100">
        <a href="/dashboard" class="w-full sm:w-auto text-center px-4 py-2.5 border border-slate-200 hover:bg-slate-50 text-slate-600 font-semibold text-xs rounded-xl transition-colors">
          Kembali ke Dashboard
        </a>

        <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-[#6c5dd3] hover:bg-violet-700 text-white font-bold text-xs rounded-xl shadow-md shadow-violet-200 transition-all flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>Simpan Kata Sandi Baru</span>
        </button>
      </div>
    </form>
  </div>

</div>

<script>
  const originalAvatarSrc = "<%= user.avatar %>";

  function handleAvatarSelected(input) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('avatarImagePreview').src = e.target.result;
        document.getElementById('avatarSaveBox').classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    }
  }

  function cancelAvatarSelection() {
    document.getElementById('avatarFileInput').value = "";
    document.getElementById('avatarImagePreview').src = originalAvatarSrc;
    document.getElementById('avatarSaveBox').classList.add('hidden');
  }

  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      btn.classList.add('text-brand-600');
    } else {
      input.type = 'password';
      btn.classList.remove('text-brand-600');
    }
  }
</script>
